<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_sbp_plan" model="ir.sequence">
            <field name="name">EH SBP Plan Reference</field>
            <field name="code">eh.sbp.plan</field>
            <field name="prefix">SBP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_sbp_period_run" model="ir.sequence">
            <field name="name">EH SBP Period Run Reference</field>
            <field name="code">eh.sbp.period.run</field>
            <field name="prefix">SBPR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_sbp_valuation" model="ir.sequence">
            <field name="name">EH SBP Valuation Reference</field>
            <field name="code">eh.sbp.valuation</field>
            <field name="prefix">SBPV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
