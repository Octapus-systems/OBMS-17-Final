<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Per-company FX rate provider configuration.

        One row per company. The provider list comes from the registry
        in tools/rate_providers.py so adding a new source is purely a
        Python change; the selection refreshes automatically.
    -->

    <record id="view_eh_fx_rate_config_list" model="ir.ui.view">
        <field name="name">eh.fx.rate.config.list</field>
        <field name="model">eh.fx.rate.config</field>
        <field name="arch" type="xml">
            <tree string="FX Rate Providers" create="true" edit="true">
                <field name="company_id"/>
                <field name="provider"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="last_fetched_at"/>
                <field name="last_fetch_summary"/>
                <field name="last_error"
                       optional="show"
                       decoration-danger="last_error"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_fx_rate_config_form" model="ir.ui.view">
        <field name="name">eh.fx.rate.config.form</field>
        <field name="model">eh.fx.rate.config</field>
        <field name="arch" type="xml">
            <form string="FX Rate Provider">
                <header>
                    <button name="action_update_now" type="object"
                            string="Update now" class="btn-primary"
                            icon="fa-refresh"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="provider"/>
                            <field name="fallback_provider"/>
                            <field name="provider_needs_key" invisible="1"/>
                            <field name="api_key" password="True"
                                   invisible="not provider_needs_key"
                                   required="provider_needs_key"/>
                            <field name="enabled"/>
                            <field name="fetch_frequency"/>
                            <field name="timeout_seconds"/>
                        </group>
                        <group>
                            <field name="last_fetched_at" readonly="1"/>
                            <field name="last_fetch_summary" readonly="1"/>
                            <field name="last_error" readonly="1"
                                   decoration-danger="last_error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Manual overrides" name="overrides">
                            <field name="override_line_ids">
                                <tree editable="bottom">
                                    <field name="currency_id"/>
                                    <field name="inverse_company_rate"/>
                                    <field name="active" widget="boolean_toggle"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                            <p class="text-muted">
                                A manual override always wins over the fetched rate. Use it to pin a currency that has no clean feed (or whose terms restrict redistribution) while every other currency keeps auto-updating. This is finer grained than the all-or-nothing Manual provider.
                            </p>
                        </page>
                    </notebook>
                    <p class="text-muted">
                        Central-bank sources (ECB, Bank of Canada, National Bank of Poland, Bank of Russia, Central Bank of Turkey, Reserve Bank of Australia, Central Bank of Brazil, HMRC) publish against their own base currency and need no API key; cross-rates into the company currency are derived automatically. Aggregator sources serve broad coverage and some require an API key in the field above. The Manual provider disables automatic fetch so finance enters rates by hand into Currencies &gt; Rates.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_fx_rate_config" model="ir.actions.act_window">
        <field name="name">FX Rate Providers</field>
        <field name="res_model">eh.fx.rate.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No FX rate provider configured.
            </p>
            <p>
                Add one config per company that revalues foreign-currency
                balances. The daily cron fetches rates and writes them
                into Odoo's standard res.currency.rate so every revaluation
                run has the data it needs.
            </p>
        </field>
    </record>

</odoo>
