<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_fx_revaluation_run" model="ir.sequence">
            <field name="name">EH FX Revaluation Run Reference</field>
            <field name="code">eh.fx.revaluation.run</field>
            <field name="prefix">FXR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_fx_hedge" model="ir.sequence">
            <field name="name">EH FX Hedge Reference</field>
            <field name="code">eh.fx.hedge</field>
            <field name="prefix">HEDGE/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
