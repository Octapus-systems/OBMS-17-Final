#. module: eh_account_fx_revaluation
#: model:ir.model.fields,help:eh_account_fx_revaluation.field_eh_fx_hedge_test__offset_ratio
msgid ""
"Absolute ratio of |instrument change| to |hedged change|. Must fall within "
"0.80-1.25 to pass the dollar-offset test."
msgstr ""
