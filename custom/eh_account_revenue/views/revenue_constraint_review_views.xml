<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_revenue_constraint_review_list" model="ir.ui.view">
        <field name="name">eh.revenue.constraint.review.list</field>
        <field name="model">eh.revenue.constraint.review</field>
        <field name="arch" type="xml">
            <tree>
                <field name="review_date"/>
                <field name="contract_id"/>
                <field name="obligation_id"/>
                <field name="previous_estimate" widget="monetary"/>
                <field name="previous_constraint" widget="monetary"/>
                <field name="new_estimate" widget="monetary"/>
                <field name="new_constraint" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'applied'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_revenue_constraint_review_form" model="ir.ui.view">
        <field name="name">eh.revenue.constraint.review.form</field>
        <field name="model">eh.revenue.constraint.review</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply" type="object"
                            string="Apply Review" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="eh_account_base.group_eh_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,applied" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"
                                   readonly="state != 'draft'"/>
                            <field name="obligation_id"
                                   readonly="state != 'draft'"/>
                            <field name="review_date"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="previous_estimate" widget="monetary"
                                   readonly="1"/>
                            <field name="previous_constraint" widget="monetary"
                                   readonly="1"/>
                            <field name="new_estimate" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="new_constraint" widget="monetary"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Rationale">
                        <field name="rationale" colspan="2" nolabel="1"
                               readonly="state != 'draft'"
                               placeholder="Evidence that the revised amount included in the transaction price is highly probable not to reverse (IFRS 15.56). Required before the review can be applied."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="view_eh_revenue_constraint_review_search" model="ir.ui.view">
        <field name="name">eh.revenue.constraint.review.search</field>
        <field name="model">eh.revenue.constraint.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_id"/>
                <field name="obligation_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_applied" string="Applied"
                        domain="[('state', '=', 'applied')]"/>
                <group>
                    <filter name="group_contract" string="Contract"
                            context="{'group_by': 'contract_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eh_revenue_constraint_review" model="ir.actions.act_window">
        <field name="name">Constraint Reviews</field>
        <field name="res_model">eh.revenue.constraint.review</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_eh_revenue_constraint_review_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No constraint reviews yet.</p>
            <p>IFRS 15.56 requires the variable consideration estimate and its constraint to be reassessed at the end of each reporting period. Use Period Constraint Review on a revenue contract to open the drafts; applying a review posts the balanced catch-up and freezes it as the audit trail.</p>
        </field>
    </record>

</odoo>
