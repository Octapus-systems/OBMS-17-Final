<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_peppol_inbound" model="ir.sequence">
            <field name="name">Peppol inbound sequence</field>
            <field name="code">eh.peppol.inbound</field>
            <field name="prefix">PIN/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
        </record>

        <!--
            Hourly poll across registered access-point adapters.
            Manual adapter is a no-op; real adapters (Storecove, etc.)
            register at install and start producing inbound records
            without further config.
        -->
        <record id="cron_eh_peppol_poll" model="ir.cron">
            <field name="name">ERP Heritage: Poll Peppol access points</field>
            <field name="model_id" ref="model_eh_peppol_inbound"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_access_points()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
