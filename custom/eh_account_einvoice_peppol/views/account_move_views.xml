<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_account_move_form_eh_peppol" model="ir.ui.view">
        <field name="name">account.move.form.eh.peppol</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_eh_export_peppol_xml"
                        type="object"
                        string="Export Peppol XML"
                        groups="eh_account_base.group_eh_user"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
                <button name="action_eh_send_peppol"
                        type="object"
                        string="Send via Peppol"
                        class="btn-primary"
                        groups="eh_account_base.group_eh_user"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or eh_peppol_transmission_status in ('queued', 'sent', 'delivered')"/>
                <button name="action_eh_void_peppol_transmission"
                        type="object"
                        string="Void transmission / re-cut"
                        confirm="Void this Peppol transmission so the invoice can be re-cut? Any file already routed for this invoice must not be treated as the final e-invoice; the next Send supersedes it."
                        groups="eh_account_base.group_eh_manager"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or eh_peppol_transmission_status not in ('queued', 'error')"/>
                <field name="eh_peppol_transmission_status"
                       widget="badge"
                       decoration-success="eh_peppol_transmission_status == 'delivered'"
                       decoration-info="eh_peppol_transmission_status in ('sent', 'queued')"
                       decoration-danger="eh_peppol_transmission_status == 'error'"
                       invisible="eh_peppol_transmission_status == 'not_sent'"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_eh_peppol" model="ir.ui.view">
        <field name="name">res.partner.form.eh.peppol</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="eh_peppol_endpoint_id"
                       placeholder="e.g. 0151:12345678901"
                       groups="eh_account_base.group_eh_user"/>
                <field name="eh_peppol_endpoint_scheme"
                       groups="eh_account_base.group_eh_user"/>
                <field name="eh_peppol_legal_id"
                       groups="eh_account_base.group_eh_user"/>
            </xpath>
        </field>
    </record>

</odoo>
