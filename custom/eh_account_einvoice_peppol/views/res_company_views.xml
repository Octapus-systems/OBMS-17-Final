<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_res_company_form_eh_peppol" model="ir.ui.view">
        <field name="name">res.company.form.eh.peppol</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Peppol" name="eh_peppol">
                    <group string="Peppol access point">
                        <field name="eh_peppol_access_point_key"/>
                        <field name="eh_peppol_ap_config" widget="text"/>
                        <field name="eh_peppol_inbox_email"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
