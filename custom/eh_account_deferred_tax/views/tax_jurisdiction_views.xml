<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_tax_jurisdiction_list" model="ir.ui.view">
        <field name="name">eh.tax.jurisdiction.list</field>
        <field name="model">eh.tax.jurisdiction</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="country_id" optional="show"/>
                <field name="is_company_default"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_tax_jurisdiction_form" model="ir.ui.view">
        <field name="name">eh.tax.jurisdiction.form</field>
        <field name="model">eh.tax.jurisdiction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Australia (federal income tax)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="country_id"/>
                            <field name="is_company_default"/>
                        </group>
                        <group>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Enacted Rates">
                            <field name="rate_ids">
                                <tree editable="bottom">
                                    <field name="effective_from"/>
                                    <field name="enacted_date"/>
                                    <field name="rate"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_tax_jurisdiction" model="ir.actions.act_window">
        <field name="name">Tax Jurisdictions</field>
        <field name="res_model">eh.tax.jurisdiction</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up a tax jurisdiction
            </p>
            <p>
                Each jurisdiction carries its enacted-rate history
                (IAS 12.47). Deferred tax lines resolve their rate from the
                table at the run's reporting date, and the net offsetting
                policy (IAS 12.74) nets assets against liabilities per
                jurisdiction.
            </p>
        </field>
    </record>

</odoo>
