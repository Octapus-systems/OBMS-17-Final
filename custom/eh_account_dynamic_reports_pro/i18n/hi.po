#. module: eh_account_dynamic_reports_pro
#: model:ir.model.fields,help:eh_account_dynamic_reports_pro.field_eh_report_builder_line__level
msgid ""
"0 for section headers and computed totals (rendered bold), 1 for data rows."
msgstr ""
"अनुभाग शीर्षकों और गणना किए गए योगों (मोटे अक्षरों में) के लिए 0, डेटा "
"पंक्तियों के लिए 1।"

#. module: eh_account_dynamic_reports_pro
#: model_terms:ir.ui.view,arch_db:eh_account_dynamic_reports_pro.view_eh_report_forecast_form
