#. module: eh_account_dynamic_reports_pro
#: model_terms:ir.ui.view,arch_db:eh_account_dynamic_reports_pro.view_eh_report_builder_form
msgid ""
"seq  type                name              code         scope/codes  sign  formula\n"
"10   section_header      Income            -            -            -     -\n"
"20   account_aggregate   Revenue           revenue      types/income  -     -\n"
"30   account_aggregate   Other income      other_inc    types/income_other  -  -\n"
"40   formula             Total Income      total_inc    -            -     revenue + other_inc\n"
"50   section_header      Expenses          -            -            -     -\n"
"60   account_aggregate   Direct costs      direct_cost  types/expense_direct_cost  +  -\n"
"70   account_aggregate   Operating costs   op_cost      types/expense  +  -\n"
"80   formula             Total Expenses    total_exp    -            -     direct_cost + op_cost\n"
"90   formula             Net Profit        net_profit   -            -     total_inc - total_exp"
msgstr ""
"seq  type                name              code         scope/codes  sign  "
"formula\\n10   section_header      Income            -            -"
"            -     -\\n20   account_aggregate   Revenue           revenue"
"      types/income  -     -\\n30   account_aggregate   Other income      "
"other_inc    types/income_other  -  -\\n40   formula             Total "
"Income      total_inc    -            -     revenue + other_inc\\n50   "
"section_header      Expenses          -            -            -     -\\n60"
"   account_aggregate   Direct costs      direct_cost  "
"types/expense_direct_cost  +  -\\n70   account_aggregate   Operating costs"
"   op_cost      types/expense  +  -\\n80   formula             Total "
"Expenses    total_exp    -            -     direct_cost + op_cost\\n90   "
"formula             Net Profit        net_profit   -            -     "
"total_inc - total_exp"
