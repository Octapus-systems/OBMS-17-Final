<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="HrDashboardMain">
        <div class="oh_dashboards h-100 bg-light" style="background-color: #f4f6f9 !important;">
            <div class="container-fluid py-4 o_hr_dashboard">
                <link rel="stylesheet" href="/hrms_dashboard/static/src/css/hrms_dashboard.css"/>
                <t t-if="this.state.login_employee">
                    <div class="row g-4">
                        <!-- Left Sidebar (Profile) -->
                        <div class="col-12 col-xl-3 col-lg-4">
                            <t t-call="LoginEmployeeDetails"/>
                        </div>
                        
                        <!-- Right Content Area -->
                        <div class="col-12 col-xl-9 col-lg-8">
                            <div class="d-flex flex-column gap-4">
                                <t t-call="LoginEmployeeTopStats"/>
                                
                                <t t-if="this.state.is_manager == true">
                                    <t t-call="ManagerDashboard"/>
                                    <t t-call="EmployeeDashboard"/>
                                </t>
                                <t t-else="">
                                    <t t-call="EmployeeDashboard"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

    <!-- Profile Sidebar -->
    <t t-name="LoginEmployeeDetails">
        <div class="card h-100 border-0 shadow-sm oh-profile-card">
            <div class="card-body p-0 text-center d-flex flex-column">
                <div class="profile-header bg-gradient-primary p-4 rounded-top position-relative text-white">
                    <div class="profile-avatar-container mx-auto mb-3 shadow">
                        <t t-if="this.state.login_employee['image_1920']">
                            <img class="img-fluid rounded-circle" alt="Profile"
                                 t-att-src="'data:image/png;base64,'+this.state.login_employee['image_1920']"/>
                        </t>
                        <t t-else="">
                            <div class="default-avatar d-flex align-items-center justify-content-center bg-white text-primary rounded-circle w-100 h-100">
                                <i class="fa fa-user fa-3x"/>
                            </div>
                        </t>
                    </div>
                    <h4 class="mb-1 fw-bold text-white"><t t-esc="this.state.login_employee['name']"/></h4>
                    <p class="mb-0 opacity-75 small text-uppercase fw-semibold tracking-wider">
                        <t t-if="this.state.login_employee['job_id']">
                            <t t-esc="this.state.login_employee['job_id'][1]"/>
                        </t>
                        <t t-else="">
                            Add job title
                        </t>
                    </p>
                </div>
                
                <div class="profile-details p-4 flex-grow-1 bg-white rounded-bottom">
                    <div class="row g-4 text-start">
                        <div class="col-6 border-end border-bottom pb-3">
                            <small class="text-muted text-uppercase fw-bold text-xs">Gender</small>
                            <div class="fw-semibold text-dark d-flex align-items-center mt-1">
                                <t t-if="this.state.login_employee['gender'] == 'male'"><i class="fa fa-mars me-2 text-primary"/> Male</t>
                                <t t-elif="this.state.login_employee['gender'] == 'female'"><i class="fa fa-venus me-2 text-danger"/> Female</t>
                                <t t-elif="this.state.login_employee['gender'] == 'other'">Other</t>
                                <t t-else="">---</t>
                            </div>
                        </div>
                        <div class="col-6 border-bottom pb-3 ps-4">
                            <small class="text-muted text-uppercase fw-bold text-xs">Age</small>
                            <div class="fw-semibold text-dark mt-1">
                                <t t-if="this.state.login_employee['age']"><t t-esc="this.state.login_employee['age']"/> yrs</t>
                                <t t-else="">---</t>
                            </div>
                        </div>
                        <div class="col-6 border-end pt-3">
                            <small class="text-muted text-uppercase fw-bold text-xs">Joined</small>
                            <div class="fw-semibold text-dark mt-1">
                                <t t-if="this.state.login_employee['experience']"><t t-esc="this.state.login_employee['experience']"/> Ago</t>
                                <t t-else="">---</t>
                            </div>
                        </div>
                        <div class="col-6 pt-3 ps-4">
                            <small class="text-muted text-uppercase fw-bold text-xs">Nationality</small>
                            <div class="fw-semibold text-dark mt-1 text-truncate" t-att-title="this.state.login_employee['country_id'] ? this.state.login_employee['country_id'][1] : ''">
                                <t t-if="this.state.login_employee['country_id']"><t t-esc="this.state.login_employee['country_id'][1]"/></t>
                                <t t-else="">---</t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Top Stats -->
    <t t-name="LoginEmployeeTopStats">
        <div class="row g-3">
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card h-100 border-0 shadow-sm oh-stat-card cursor-pointer hover-lift" t-on-click="hr_payslip">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="icon-box bg-orange-soft text-orange rounded p-2">
                                <i class="fa fa-money fa-lg"/>
                            </div>
                            <h3 class="fw-bold mb-0 text-dark"><t t-esc="this.state.login_employee['payslip_count']"/></h3>
                        </div>
                        <h6 class="text-muted mb-0 fw-semibold text-sm">Payslips</h6>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <div class="card h-100 border-0 shadow-sm oh-stat-card cursor-pointer hover-lift" t-on-click="hr_timesheets">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="icon-box bg-info-soft text-info rounded p-2">
                                <i class="fa fa-clock-o fa-lg"/>
                            </div>
                            <h3 class="fw-bold mb-0 text-dark"><t t-esc="this.state.login_employee['emp_timesheets']"/></h3>
                        </div>
                        <h6 class="text-muted mb-0 fw-semibold text-sm">Timesheets</h6>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <div class="card h-100 border-0 shadow-sm oh-stat-card cursor-pointer hover-lift" t-on-click="hr_contract">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="icon-box bg-purple-soft text-purple rounded p-2">
                                <i class="fa fa-book fa-lg"/>
                            </div>
                            <h3 class="fw-bold mb-0 text-dark"><t t-esc="this.state.login_employee['contracts_count']"/></h3>
                        </div>
                        <h6 class="text-muted mb-0 fw-semibold text-sm">Contracts</h6>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-4 col-xl-3">
                <div class="card h-100 border-0 shadow-sm oh-stat-card cursor-pointer hover-lift" t-on-click="employee_broad_factor">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="icon-box bg-teal-soft text-teal rounded p-2">
                                <i class="fa fa-bar-chart fa-lg"/>
                            </div>
                            <h3 class="fw-bold mb-0 text-dark"><t t-esc="this.state.login_employee['broad_factor']"/></h3>
                        </div>
                        <h6 class="text-muted mb-0 fw-semibold text-sm">Broad Factor</h6>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-8 col-xl-3">
                <div class="card h-100 border-0 shadow-sm checkin-card cursor-pointer hover-lift" t-ref="log_in_out" t-on-click="attendance_sign_in_out">
                    <div t-attf-class="card-body p-3 d-flex align-items-center justify-content-center h-100 {{ this.state.login_employee['attendance_state'] == 'checked_out' ? 'bg-success-gradient text-white' : 'bg-danger-gradient text-white' }} rounded">
                        <i t-attf-class="fa fa-2x me-3 {{ this.state.login_employee['attendance_state'] == 'checked_out' ? 'fa-sign-in' : 'fa-sign-out' }}"/>
                        <h4 class="fw-bold mb-0">
                            <t t-if="this.state.login_employee['attendance_state'] == 'checked_out'">Check In</t>
                            <t t-else="">Check Out</t>
                        </h4>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- ManagerDashboard -->
    <t t-name="ManagerDashboard">
        <div class="row g-4">
            <div class="col-12 col-lg-5">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="card border-0 shadow-sm bg-orange-gradient text-white h-100 cursor-pointer hover-lift" t-on-click="leaves_to_approve">
                            <div class="card-body d-flex flex-column justify-content-center text-center p-4">
                                <h2 class="display-5 fw-bold mb-2"><t t-esc="this.state.login_employee.leaves_to_approve"/></h2>
                                <h6 class="mb-0 text-uppercase tracking-wider">Leave Requests</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex flex-column h-100 gap-3">
                            <div class="card border-0 shadow-sm bg-info-gradient text-white flex-grow-1 cursor-pointer hover-lift" t-on-click="leaves_request_today">
                                <div class="card-body d-flex align-items-center justify-content-between p-3">
                                    <h6 class="mb-0 text-uppercase tracking-wider">Today</h6>
                                    <h3 class="fw-bold mb-0"><t t-esc="this.state.login_employee.leaves_today"/></h3>
                                </div>
                            </div>
                            <div class="card border-0 shadow-sm bg-purple-gradient text-white flex-grow-1 cursor-pointer hover-lift" t-on-click="leaves_request_month">
                                <div class="card-body d-flex align-items-center justify-content-between p-3">
                                    <h6 class="mb-0 text-uppercase tracking-wider text-xs">This Month</h6>
                                    <h3 class="fw-bold mb-0"><t t-esc="this.state.login_employee.leaves_this_month"/></h3>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card border-0 shadow-sm bg-orange-gradient text-white cursor-pointer hover-lift" t-on-click="leave_allocations_to_approve">
                            <div class="card-body d-flex align-items-center justify-content-between p-3">
                                <h6 class="mb-0 text-uppercase tracking-wider text-xs">Allocations</h6>
                                <h3 class="fw-bold mb-0"><t t-esc="this.state.login_employee.leaves_alloc_req"/></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card border-0 shadow-sm bg-teal-gradient text-white cursor-pointer hover-lift" t-on-click="job_applications_to_approve">
                            <div class="card-body d-flex align-items-center justify-content-between p-3">
                                <h6 class="mb-0 text-uppercase tracking-wider text-xs">Job Apps</h6>
                                <h3 class="fw-bold mb-0"><t t-esc="this.state.login_employee.job_applications"/></h3>
                            </div>
                        </div>
                    </div>

                    <!-- Custom Quick Approvals: Loans, Salary Advances -->
                    <div class="col-6">
                        <div class="card border-0 shadow-sm bg-purple-gradient text-white cursor-pointer hover-lift" t-on-click="loans_to_approve">
                            <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                                <h4 class="fw-bold mb-1"><t t-esc="this.state.login_employee.loans_to_approve"/></h4>
                                <h6 class="mb-0 text-uppercase text-xs tracking-wider">Loans</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card border-0 shadow-sm bg-info-gradient text-white cursor-pointer hover-lift" t-on-click="advances_to_approve">
                            <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                                <h4 class="fw-bold mb-1"><t t-esc="this.state.login_employee.advances_to_approve"/></h4>
                                <h6 class="mb-0 text-uppercase text-xs tracking-wider">Advances</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-12 col-lg-7">
                <div class="card h-100 border-0 shadow-sm oh-chart-card">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="card-title fw-bold text-dark mb-0">Departments</h5>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center min-h-300">
                        <div class="emp_graph w-100" t-ref="emp_graph"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-1">
            <div class="col-12">
                <div class="card border-0 shadow-sm oh-chart-card">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="card-title fw-bold text-dark mb-0">Monthly Leave Analysis</h5>
                    </div>
                    <div class="card-body min-h-300">
                        <div class="leave_graph w-100" t-ref="leave_graph"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-1">
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm oh-chart-card h-100">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="card-title fw-bold text-dark mb-0">Monthly Join/Resign Analysis</h5>
                    </div>
                    <div class="card-body min-h-300">
                        <div class="join_resign_trend w-100" t-ref="join_resign_trend"></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm oh-chart-card h-100">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="card-title fw-bold text-dark mb-0">Attrition Rate</h5>
                    </div>
                    <div class="card-body min-h-300">
                        <div class="attrition_rate w-100" t-ref="attrition_rate"></div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- EmployeeDashboard -->
    <t t-name="EmployeeDashboard">
        <div class="row g-4 mt-1">
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100 notification-card">
                    <div class="card-header bg-white border-bottom pt-4 pb-3">
                        <h5 class="card-title fw-bold text-dark mb-0"><i class="fa fa-birthday-cake text-primary me-2"/> Upcoming Birthdays</h5>
                    </div>
                    <div class="card-body p-0 custom-scrollbar" style="max-height: 350px; overflow-y: auto;">
                        <ul class="list-group list-group-flush">
                            <t t-if="this.state.employee_birthday and this.state.employee_birthday.length > 0">
                                <t t-foreach="this.state.employee_birthday" t-as="employee" t-key="employee">
                                    <li class="list-group-item p-3 border-bottom-0">
                                        <div class="d-flex align-items-center">
                                            <img class="rounded-circle me-3 border" width="48" height="48" alt=""
                                                 t-att-src="this.get_emp_image_url(employee[0])"/>
                                            <div>
                                                <h6 class="mb-1 fw-bold text-dark"><t t-esc="employee[1]"/></h6>
                                                <div class="text-muted small"><i class="fa fa-calendar me-1"/> <t t-esc="employee[3]['en_US']"/></div>
                                            </div>
                                        </div>
                                    </li>
                                </t>
                            </t>
                            <t t-else="">
                                <li class="list-group-item p-4 text-center text-muted border-0">
                                    No upcoming birthdays.
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100 notification-card">
                    <div class="card-header bg-white border-bottom pt-4 pb-3">
                        <h5 class="card-title fw-bold text-dark mb-0"><i class="fa fa-bullhorn text-warning me-2"/> Announcements</h5>
                    </div>
                    <div class="card-body p-0 custom-scrollbar" style="max-height: 350px; overflow-y: auto;">
                        <ul class="list-group list-group-flush">
                            <t t-if="this.state.announcements and this.state.announcements.length > 0">
                                <t t-foreach="this.state.announcements" t-as="announcement" t-key="announcement">
                                    <li class="list-group-item p-3 border-bottom-0">
                                        <h6 class="mb-1 fw-bold text-dark"><t t-esc="announcement[0]"/></h6>
                                        <div class="text-muted small"><t t-esc="announcement[1]"/></div>
                                    </li>
                                </t>
                            </t>
                            <t t-else="">
                                <li class="list-group-item p-4 text-center text-muted border-0">
                                    No recent announcements.
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-1 mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm oh-chart-card">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="card-title fw-bold text-dark mb-0">My Leave Analysis</h5>
                    </div>
                    <div class="card-body min-h-300">
                        <div class="leave_trend w-100" t-ref="leave_trend"></div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- EmployeeWarning -->
    <t t-name="EmployeeWarning">
        <div class="container mt-5">
            <div class="alert alert-danger shadow-sm border-0 rounded p-4 text-center">
                <i class="fa fa-exclamation-triangle fa-3x mb-3 text-danger"/>
                <h4 class="alert-heading fw-bold">Error: Profile Not Linked</h4>
                <p class="mb-0">Could not find an employee record linked to your user account. Please contact your system administrator to complete your setup.</p>
            </div>
        </div>
    </t>

</templates>
