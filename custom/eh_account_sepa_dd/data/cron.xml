<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            Daily cron flips dormant mandates to expired so the list
            view reflects scheme reality without waiting for a
            collection attempt to surface the dormancy. The 36-month
            rule is also enforced inside consume_for_collection, so
            the cron is belt-and-braces.
        -->
        <record id="cron_eh_sepa_mandate_expire_dormant" model="ir.cron">
            <field name="name">ERP Heritage: Expire dormant SEPA mandates</field>
            <field name="model_id" ref="model_eh_sepa_mandate"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_dormant()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
