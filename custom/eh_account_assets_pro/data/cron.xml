<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_post_due_assets" model="ir.cron">
            <field name="name">EH Account Assets Pro: post due asset depreciation</field>
            <field name="model_id" ref="model_eh_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_post_due()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_post_due_leases" model="ir.cron">
            <field name="name">EH Account Assets Pro: post due lease entries</field>
            <field name="model_id" ref="model_eh_lease_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_post_due()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- IAS 36.10: goodwill and indefinite-life intangibles must be
             tested for impairment annually irrespective of indicators.
             Weekly pass; per company it flags population assets with no
             test evidence in the current fiscal year once the annual
             test month has been reached, and schedules a to-do. -->
        <record id="ir_cron_ias36_annual_test" model="ir.cron">
            <field name="name">EH Account Assets Pro: IAS 36 annual impairment test check</field>
            <field name="model_id" ref="model_eh_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_ias36_annual_test()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
