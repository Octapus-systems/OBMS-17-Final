<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_asset" model="ir.sequence">
            <field name="name">EH Asset Reference</field>
            <field name="code">eh.asset</field>
            <field name="prefix">FA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_lease_contract" model="ir.sequence">
            <field name="name">EH Lease Contract Reference</field>
            <field name="code">eh.lease.contract</field>
            <field name="prefix">LSE/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
