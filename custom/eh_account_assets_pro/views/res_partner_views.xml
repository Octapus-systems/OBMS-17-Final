<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_partner_form_assets" model="ir.ui.view">
        <field name="name">eh.account.assets_pro.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_eh_assets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cube"
                        invisible="eh_asset_count == 0">
                    <field name="eh_asset_count"
                           widget="statinfo"
                           string="Assets"/>
                </button>
                <button name="action_view_eh_leases"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="eh_lease_count == 0">
                    <field name="eh_lease_count"
                           widget="statinfo"
                           string="Leases"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
