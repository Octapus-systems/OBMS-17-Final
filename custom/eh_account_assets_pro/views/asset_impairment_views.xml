<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_asset_impairment_tree" model="ir.ui.view">
        <field name="name">eh.asset.impairment.list</field>
        <field name="model">eh.asset.impairment</field>
        <field name="arch" type="xml">
            <tree string="Asset impairments"
                  default_order="impairment_date desc"
                  decoration-success="state == 'posted' and not is_reversal"
                  decoration-info="state == 'posted' and is_reversal"
                  decoration-muted="state == 'cancelled'">
                <field name="impairment_date"/>
                <field name="asset_id"/>
                <field name="amount" sum="Total" widget="monetary"/>
                <field name="is_reversal" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="cgu_id" optional="hide"/>
                <field name="move_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_asset_impairment_form" model="ir.ui.view">
        <field name="name">eh.asset.impairment.form</field>
        <field name="model">eh.asset.impairment</field>
        <field name="arch" type="xml">
            <form string="Asset impairment">
                <header>
                    <button name="action_post"
                            type="object"
                            string="Post"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state == 'cancelled'"
                            confirm="Cancel this impairment? Posted moves will be set to draft and cancelled."/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="impairment_date"
                                   readonly="state != 'draft'"/>
                            <field name="amount" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="is_reversal"
                                   readonly="state != 'draft'"/>
                            <field name="recoverable_amount" widget="monetary"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="impairment_account_id"
                                   readonly="state != 'draft'"/>
                            <field name="accumulated_account_id"
                                   readonly="state != 'draft'"/>
                            <field name="journal_id"
                                   readonly="state != 'draft'"/>
                            <field name="cgu_id" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                            <field name="posted_at" readonly="1"/>
                            <field name="posted_by_id" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Reason"/>
                    <field name="reason"
                           placeholder="Indicator of impairment, recoverable amount calculation, valuation method..."
                           readonly="state != 'draft'"/>
                    <field name="currency_id" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="view_eh_asset_impairment_search" model="ir.ui.view">
        <field name="name">eh.asset.impairment.search</field>
        <field name="model">eh.asset.impairment</field>
        <field name="arch" type="xml">
            <search string="Asset impairments">
                <field name="asset_id"/>
                <field name="move_id"/>
                <filter string="Charges" name="charges"
                        domain="[('is_reversal', '=', False)]"/>
                <filter string="Reversals" name="reversals"
                        domain="[('is_reversal', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="state_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="state_posted"
                        domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled" name="state_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter string="Asset" name="group_asset"
                            context="{'group_by': 'asset_id'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Date (month)" name="group_date"
                            context="{'group_by': 'impairment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eh_asset_impairment" model="ir.actions.act_window">
        <field name="name">Asset impairments</field>
        <field name="res_model">eh.asset.impairment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_eh_asset_impairment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first impairment</p>
            <p>Post IAS 36 impairment charges and reversals against an asset carrying amount. Use New to select the asset, enter the recoverable amount and post the balanced entry.</p>
        </field>
    </record>

</odoo>
