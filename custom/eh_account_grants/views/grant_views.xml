<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_gov_grant_list" model="ir.ui.view">
        <field name="name">eh.gov.grant.list</field>
        <field name="model">eh.gov.grant</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="grant_type"/>
                <field name="grant_kind" optional="show"/>
                <field name="grant_date"/>
                <field name="amount" widget="monetary"/>
                <field name="recognised_amount" widget="monetary" optional="show"/>
                <field name="remaining" widget="monetary" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'received'"
                       decoration-success="state == 'closed'"
                       decoration-warning="state == 'repaid'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_gov_grant_form" model="ir.ui.view">
        <field name="name">eh.gov.grant.form</field>
        <field name="model">eh.gov.grant</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_receive" type="object"
                            string="Receive" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_amortise" type="object"
                            string="Amortise to Income"
                            invisible="state != 'received'"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_repay" type="object"
                            string="Repay"
                            invisible="state != 'received' or (grant_type == 'asset_related' and asset_approach == 'deduct_asset')"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_accrue_clawback" type="object"
                            string="Accrue Clawback"
                            invisible="state != 'received' or (grant_type == 'asset_related' and asset_approach == 'deduct_asset') or clawback_accrued != 0 or breached_condition_count == 0"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('closed', 'repaid', 'cancelled')"/>
                    <field name="clawback_accrued" invisible="1"/>
                    <field name="breached_condition_count" invisible="1"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,received,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="move_count" widget="statinfo"
                                   string="Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="grant_type"
                                   readonly="state != 'draft'"/>
                            <field name="asset_approach"
                                   invisible="grant_type != 'asset_related'"
                                   readonly="state != 'draft'"/>
                            <field name="grant_kind"
                                   readonly="state != 'draft'"/>
                            <field name="grant_date"/>
                            <field name="amount" widget="monetary"
                                   invisible="grant_kind == 'non_monetary'"
                                   readonly="state != 'draft'"/>
                            <field name="asset_fair_value" widget="monetary"
                                   invisible="grant_kind != 'non_monetary'"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="recognised_amount" widget="monetary" readonly="1"/>
                            <field name="remaining" widget="monetary" readonly="1"/>
                            <field name="amortise_amount" widget="monetary"
                                   invisible="state != 'received' or (grant_type == 'asset_related' and asset_approach == 'deduct_asset')"/>
                            <field name="amortise_date"
                                   invisible="state != 'received' or (grant_type == 'asset_related' and asset_approach == 'deduct_asset')"/>
                            <field name="repayment_amount" widget="monetary"
                                   invisible="state != 'received' or (grant_type == 'asset_related' and asset_approach == 'deduct_asset')"/>
                        </group>
                    </group>
                    <group string="Accounts">
                        <group>
                            <field name="cash_account_id"/>
                            <field name="received_asset_account_id"
                                   invisible="grant_kind != 'non_monetary'"/>
                            <field name="deferred_income_account_id"
                                   invisible="grant_type == 'asset_related' and asset_approach == 'deduct_asset'"/>
                            <field name="grant_income_account_id"
                                   invisible="grant_type == 'asset_related' and asset_approach == 'deduct_asset'"/>
                        </group>
                        <group>
                            <field name="asset_account_id"
                                   invisible="not (grant_type == 'asset_related' and asset_approach == 'deduct_asset')"/>
                            <field name="repayment_expense_account_id"
                                   invisible="grant_type == 'asset_related' and asset_approach == 'deduct_asset'"/>
                            <field name="journal_id"/>
                        </group>
                    </group>
                    <group string="Conditions and Clawback"
                           invisible="grant_type == 'asset_related' and asset_approach == 'deduct_asset'">
                        <group>
                            <field name="defer_until_conditions"/>
                            <field name="clawback_amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="clawback_liability_account_id"/>
                            <field name="clawback_accrued" widget="monetary"
                                   readonly="1"
                                   invisible="clawback_accrued == 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conditions" name="conditions">
                            <field name="condition_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="due_date" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'open'"
                                           decoration-success="state == 'fulfilled'"
                                           decoration-danger="state == 'breached'"/>
                                    <field name="fulfilled_date" readonly="1"
                                           optional="show"/>
                                    <button name="action_fulfil" type="object"
                                            string="Fulfil" icon="fa-check"
                                            invisible="state != 'open'"/>
                                    <button name="action_reopen" type="object"
                                            string="Reopen" icon="fa-undo"
                                            invisible="state != 'fulfilled'"/>
                                    <button name="action_breach" type="object"
                                            string="Breach"
                                            icon="fa-exclamation-triangle"
                                            invisible="state != 'open'"
                                            groups="eh_account_base.group_eh_manager"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1" colspan="2"
                                   placeholder="Grant compliance notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="eh_account_grants_gov_grant_view_graph" model="ir.ui.view">
        <field name="name">eh.gov.grant.graph</field>
        <field name="model">eh.gov.grant</field>
        <field name="arch" type="xml">
            <graph string="Government Grants" sample="1">
                <field name="grant_date" interval="month"/>
                <field name="grant_type"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="eh_account_grants_gov_grant_view_pivot" model="ir.ui.view">
        <field name="name">eh.gov.grant.pivot</field>
        <field name="model">eh.gov.grant</field>
        <field name="arch" type="xml">
            <pivot string="Government Grants" sample="1">
                <field name="grant_date" interval="month" type="row"/>
                <field name="state" type="col"/>
                <field name="amount" type="measure"/>
                <field name="recognised_amount" type="measure"/>
                <field name="remaining" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_eh_gov_grant" model="ir.actions.act_window">
        <field name="name">Government Grants</field>
        <field name="res_model">eh.gov.grant</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first government grant</p>
            <p>Track government grants recognised and amortised under IAS 20, from receipt through release to income, conditions and clawback. Click New to register a grant, set its amount and accounts, then use Receive to post it.</p>
        </field>
    </record>

</odoo>
