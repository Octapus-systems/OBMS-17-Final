<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_segment_report" model="ir.sequence">
            <field name="name">EH Segment Report Reference</field>
            <field name="code">eh.segment.report</field>
            <field name="prefix">SEG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_fin_maturity_run" model="ir.sequence">
            <field name="name">EH Maturity Analysis Run Reference</field>
            <field name="code">eh.fin.maturity.run</field>
            <field name="prefix">MAT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_fin_credit_note" model="ir.sequence">
            <field name="name">EH Credit-Risk Note Reference</field>
            <field name="code">eh.fin.credit.note</field>
            <field name="prefix">CRN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_fin_sensitivity" model="ir.sequence">
            <field name="name">EH Sensitivity Analysis Reference</field>
            <field name="code">eh.fin.sensitivity</field>
            <field name="prefix">SENS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
