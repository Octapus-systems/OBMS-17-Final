<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_anomaly_finding_list" model="ir.ui.view">
        <field name="name">eh.account.anomaly.finding.list</field>
        <field name="model">eh.account.anomaly.finding</field>
        <field name="arch" type="xml">
            <tree string="Anomaly Findings"
                  decoration-danger="severity == 'high'"
                  decoration-warning="severity == 'medium'"
                  decoration-muted="state == 'dismissed'">
                <field name="detected_at"/>
                <field name="move_id"/>
                <field name="date"/>
                <field name="rule"/>
                <field name="severity"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="description"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_mark_reviewed" type="object"
                        string="Reviewed" icon="fa-check"
                        invisible="state != 'open'"/>
                <button name="action_dismiss" type="object"
                        string="Dismiss" icon="fa-ban"
                        invisible="state == 'dismissed'"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_anomaly_finding_form" model="ir.ui.view">
        <field name="name">eh.account.anomaly.finding.form</field>
        <field name="model">eh.account.anomaly.finding</field>
        <field name="arch" type="xml">
            <form string="Anomaly finding">
                <header>
                    <button name="action_mark_reviewed" type="object"
                            string="Mark reviewed" class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_dismiss" type="object"
                            string="Dismiss"
                            invisible="state == 'dismissed'"/>
                    <button name="action_reopen" type="object"
                            string="Reopen"
                            invisible="state == 'open'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,reviewed,dismissed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_move" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Open</span>
                                <span class="o_stat_text">Entry</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Evidence">
                            <field name="move_id"/>
                            <field name="date"/>
                            <field name="rule"/>
                            <field name="severity"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Review">
                            <field name="detected_at"/>
                            <field name="reviewed_by_id"/>
                            <field name="reviewed_at"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="description" readonly="1"/>
                    <separator string="Review note"/>
                    <field name="review_note"
                           placeholder="Optional notes from the reviewer..."/>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="view_eh_anomaly_finding_search" model="ir.ui.view">
        <field name="name">eh.account.anomaly.finding.search</field>
        <field name="model">eh.account.anomaly.finding</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id"/>
                <field name="rule"/>
                <filter name="open" string="Open"
                        domain="[('state', '=', 'open')]"/>
                <filter name="high" string="High severity"
                        domain="[('severity', '=', 'high')]"/>
                <separator/>
                <filter name="reviewed" string="Reviewed"
                        domain="[('state', '=', 'reviewed')]"/>
                <filter name="dismissed" string="Dismissed"
                        domain="[('state', '=', 'dismissed')]"/>
                <group>
                    <filter name="group_rule" string="Rule"
                            context="{'group_by': 'rule'}"/>
                    <filter name="group_severity" string="Severity"
                            context="{'group_by': 'severity'}"/>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eh_account_anomaly_finding" model="ir.actions.act_window">
        <field name="name">Anomaly Findings</field>
        <field name="res_model">eh.account.anomaly.finding</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No anomaly findings yet.
            </p>
            <p>
                Run the scan from a journal entry, or wait for the daily
                scheduled scan to surface round-number outliers, weekend
                postings, threshold structuring, and reversal pairs.
            </p>
        </field>
    </record>

    <menuitem id="menu_eh_account_anomaly_finding"
              name="Anomaly Findings"
              parent="eh_account_base.menu_eh_operations"
              action="action_eh_account_anomaly_finding"
              sequence="70"/>

</odoo>
