<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_ap_tolerance_profile_tree" model="ir.ui.view">
        <field name="name">eh.ap.tolerance.profile.list</field>
        <field name="model">eh.ap.tolerance.profile</field>
        <field name="arch" type="xml">
            <tree string="Tolerance Profiles" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="qty_tolerance_pct"/>
                <field name="price_tolerance_pct"/>
                <field name="amount_tolerance"/>
                <field name="over_receipt_pct"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <field name="company_id" optional="hide"
                       groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_ap_tolerance_profile_form" model="ir.ui.view">
        <field name="name">eh.ap.tolerance.profile.form</field>
        <field name="model">eh.ap.tolerance.profile</field>
        <field name="arch" type="xml">
            <form string="Tolerance Profile">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Profile name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_default"/>
                            <field name="active"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="qty_tolerance_pct"/>
                            <field name="price_tolerance_pct"/>
                            <field name="amount_tolerance"/>
                            <field name="over_receipt_pct"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_ap_tolerance_profile" model="ir.actions.act_window">
        <field name="name">Tolerance Profiles</field>
        <field name="res_model">eh.ap.tolerance.profile</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first tolerance profile</p>
            <p>Tolerance profiles set the quantity, price, amount, and over receipt limits that decide whether a matched bill line passes or raises an exception. Create one and mark it default, or assign it per vendor.</p>
        </field>
    </record>

</odoo>
