<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_res_company_form_ap_ocr" model="ir.ui.view">
        <field name="name">res.company.form.ap.ocr</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <separator string="AP vendor-bill OCR"/>
                <group>
                    <field name="eh_ap_ocr_config"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
