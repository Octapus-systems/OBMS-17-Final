<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_sepa_originator_list" model="ir.ui.view">
        <field name="name">eh.sepa.originator.list</field>
        <field name="model">eh.sepa.originator</field>
        <field name="arch" type="xml">
            <tree string="SEPA Originators">
                <field name="journal_id"/>
                <field name="initiating_party_name"/>
                <field name="iban"/>
                <field name="bic" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_sepa_originator_search" model="ir.ui.view">
        <field name="name">eh.sepa.originator.search</field>
        <field name="model">eh.sepa.originator</field>
        <field name="arch" type="xml">
            <search string="SEPA Originators">
                <field name="journal_id"/>
                <field name="initiating_party_name"/>
                <field name="iban"/>
                <field name="bic"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="filter_pain_03" string="PAIN.001.001.03"
                        domain="[('pain_001_version', '=', '03')]"/>
                <filter name="filter_pain_09" string="PAIN.001.001.09"
                        domain="[('pain_001_version', '=', '09')]"/>
                <group>
                    <filter name="group_journal" string="Bank Journal"
                            context="{'group_by': 'journal_id'}"/>
                    <filter name="group_version" string="PAIN.001 Version"
                            context="{'group_by': 'pain_001_version'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eh_sepa_originator_form" model="ir.ui.view">
        <field name="name">eh.sepa.originator.form</field>
        <field name="model">eh.sepa.originator</field>
        <field name="arch" type="xml">
            <form string="SEPA Originator">
                <sheet>
                    <h1>
                        <field name="journal_id"
                               options="{'no_create': True}"/>
                    </h1>
                    <group>
                        <group string="Initiating Party">
                            <field name="initiating_party_name"/>
                            <field name="initiating_party_identifier"/>
                        </group>
                        <group string="Source Account &amp; File Format">
                            <field name="iban"/>
                            <field name="bic"/>
                            <field name="requested_execution_offset_days"/>
                            <field name="pain_001_version"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        IBAN and BIC are validated locally on save: ISO 13616 mod-97 for IBAN, ISO 9362 structure for BIC. The export refuses to render when validation fails so configuration errors surface here, not mid-payment-run.
                    </p>
                    <group>
                        <field name="notes" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_sepa_originator" model="ir.actions.act_window">
        <field name="name">SEPA Originators</field>
        <field name="res_model">eh.sepa.originator</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_eh_sepa_originator_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No SEPA originators yet.</p>
            <p>Create one originator per bank journal you pay vendors from. The originator carries the IBAN, BIC and legal name the bank expects on every PAIN.001 file.</p>
        </field>
    </record>

</odoo>
