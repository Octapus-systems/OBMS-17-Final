<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_sepa_export_list" model="ir.ui.view">
        <field name="name">eh.sepa.export.list</field>
        <field name="model">eh.sepa.export</field>
        <field name="arch" type="xml">
            <tree string="SEPA Exports" default_order="generated_at desc"
                  create="0">
                <field name="generated_at"/>
                <field name="batch_id"/>
                <field name="message_id"/>
                <field name="transaction_count"/>
                <field name="control_sum"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'downloaded'"
                       decoration-info="state == 'generated'"
                       decoration-muted="state == 'superseded'"/>
                <field name="generated_by_id"/>
                <field name="file_hash" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_sepa_export_form" model="ir.ui.view">
        <field name="name">eh.sepa.export.form</field>
        <field name="model">eh.sepa.export</field>
        <field name="arch" type="xml">
            <form string="SEPA Export" create="0">
                <header>
                    <button name="action_download"
                            type="object"
                            string="Download"
                            class="btn-primary"
                            invisible="not attachment_id"/>
                    <button name="action_void_for_recut"
                            type="object"
                            string="Void for re-cut"
                            invisible="state == 'superseded'"
                            confirm="Void this SEPA file so the batch can be re-exported? Do this ONLY if the file was not submitted to the bank."/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="generated,downloaded"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id"/>
                            <field name="message_id"/>
                            <field name="generated_at"/>
                            <field name="generated_by_id"/>
                        </group>
                        <group>
                            <field name="transaction_count"/>
                            <field name="control_sum"/>
                            <field name="file_hash"/>
                            <field name="state"/>
                            <field name="attachment_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eh_sepa_export_kanban" model="ir.ui.view">
        <field name="name">eh.sepa.export.kanban</field>
        <field name="model">eh.sepa.export</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    quick_create="false"
                    class="o_kanban_small_column"
                    sample="1">
                <field name="message_id"/>
                <field name="batch_id"/>
                <field name="state"/>
                <field name="generated_at"/>
                <field name="transaction_count"/>
                <field name="control_sum"/>
                <field name="company_id"/>
                <templates>
                    <t t-name="kanban-box" class="row g-0">
                        <main class="col-12">
                            <field name="message_id" class="fs-5 fw-bold"/>
                            <div class="text-muted">
                                <field name="batch_id"/>
                            </div>
                            <div class="d-flex justify-content-between mt-2">
                                <span>
                                    <field name="control_sum"/>
                                </span>
                                <span class="badge text-bg-secondary">
                                    <field name="transaction_count"/> txns
                                </span>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-clock-o" title="Generated at" role="img" aria-label="Generated at"/>
                                <field name="generated_at"/>
                            </div>
                            <footer class="d-flex justify-content-end mt-2">
                                <field name="company_id"
                                       groups="base.group_multi_company"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eh_sepa_export_search" model="ir.ui.view">
        <field name="name">eh.sepa.export.search</field>
        <field name="model">eh.sepa.export</field>
        <field name="arch" type="xml">
            <search>
                <field name="message_id"/>
                <field name="batch_id"/>
                <filter name="filter_generated" string="Generated"
                        domain="[('state', '=', 'generated')]"/>
                <filter name="filter_downloaded" string="Downloaded"
                        domain="[('state', '=', 'downloaded')]"/>
                <filter name="filter_superseded" string="Superseded"
                        domain="[('state', '=', 'superseded')]"/>
                <group>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_batch" string="Batch"
                            context="{'group_by': 'batch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eh_sepa_export" model="ir.actions.act_window">
        <field name="name">SEPA Exports</field>
        <field name="res_model">eh.sepa.export</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_eh_sepa_export_search"/>
        <field name="context">{'search_default_filter_generated': 1, 'search_default_filter_downloaded': 1}</field>
    </record>

</odoo>
