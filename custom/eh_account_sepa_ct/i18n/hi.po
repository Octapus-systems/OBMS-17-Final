#. module: eh_account_sepa_ct
#. odoo-javascript
#: code:addons/eh_account_sepa_ct/static/src/js/tours/sepa_ct_tour.js:0
msgid ""
"Second: every <b>vendor</b> in the batch needs an IBAN bank account on their"
" partner record. The export refuses to run when even one payee is missing an"
" IBAN — better to fix the data than to have the bank reject the file."
msgstr ""
"दूसरा: बैच में प्रत्येक <b>विक्रेता</b> को अपने पार्टनर रिकॉर्ड पर एक IBAN "
"बैंक खाता चाहिए। जब एक भी भुगतानप्राप्तकर्ता के पास IBAN नहीं होता, तो "
"निर्यात चलने से मना कर देता है — बैंक द्वारा फ़ाइल अस्वीकृत किए जाने की "
"तुलना में डेटा ठीक करना बेहतर है।"

#. module: eh_account_sepa_ct
#: model:ir.model.fields,field_description:eh_account_sepa_ct.field_eh_batch_payment__sepa_export_ids
msgid "Sepa Export"
msgstr "SEPA निर्यात"

