msgid ""
"<div style=\"margin:0;padding:0;background-color:#FBF8F2;font-family:'Segoe UI',Roboto,Arial,sans-serif;color:#1A2C3D;\">\n"
"                    <div style=\"max-width:640px;margin:0 auto;padding:24px;background-color:#FBF8F2;\">\n"
"                        <div style=\"border-top:3px solid #C9A372;padding-top:18px;\">\n"
"                            <h1 style=\"margin:0 0 6px 0;font-size:20px;color:#1A2C3D;\">\n"
"                                SEPA Credit Transfer file generated\n"
"                            </h1>\n"
"                            <p style=\"margin:0 0 18px 0;color:#6c757d;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;\">\n"
"                                <t t-out=\"object.company_id.name\"/>\n"
"                            </p>\n"
"                        </div>\n"
"\n"
"                        <table style=\"width:100%;border-collapse:collapse;margin:18px 0;background:#fff;border:1px solid #e1e4e8;border-radius:6px;\">\n"
