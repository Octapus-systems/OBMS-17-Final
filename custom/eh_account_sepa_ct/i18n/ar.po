#. module: eh_account_sepa_ct
#: model:ir.model.fields,help:eh_account_sepa_ct.field_eh_sepa_export__activity_type_icon
msgid "Font awesome icon e.g. fa-tasks"
msgstr "أيقونة من Font awesome مثال: fa-tasks"

#. module: eh_account_sepa_ct
#. odoo-javascript
#: code:addons/eh_account_sepa_ct/static/src/js/tours/sepa_ct_tour.js:0
msgid ""
"Fourth: click <b>Export SEPA</b> on the posted batch. The file is generated,"
" validated against the PAIN.001.001.03 schema, and saved as an "
"ir.attachment. An <code>eh.sepa.export</code> audit row links the message "
"id, file hash, and control sum back to the batch."
msgstr ""
"رابعاً: انقر على <b>تصدير SEPA</b> في الدفعة المُرحَّلة. يتم إنشاء الملف "
"والتحقق منه وفق مخطط PAIN.001.001.03 وحفظه كـ ir.attachment. ويربط سطر تدقيق"
" <code>eh.sepa.export</code> معرّف الرسالة وبصمة الملف ومجموع التحكم "
"بالدفعة."

#. module: eh_account_sepa_ct
#: model_terms:ir.ui.view,arch_db:eh_account_sepa_ct.view_eh_batch_payment_form_sepa
msgid ""
"Generate the PAIN.001 SEPA Credit Transfer XML for upload to the bank. "
"Continue?"
msgstr ""
"إنشاء ملف PAIN.001 SEPA Credit Transfer XML لتحميله إلى البنك. هل تريد "
"المتابعة؟"

