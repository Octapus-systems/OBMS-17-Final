"                                </td>\n"
"                                <td style=\"padding:10px 14px;font-family:'DM Mono',monospace;font-size:11px;text-align:right;\" t-out=\"object.file_hash\"/>\n"
"                            </tr>\n"
"                        </table>\n"
"\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            The file is attached. Upload it to the bank\n"
"                            portal and forward the bank's acceptance\n"
"                            confirmation back to this thread for the\n"
"                            audit log.\n"
"                        </p>\n"
"\n"
"                        <div style=\"margin-top:32px;padding-top:14px;border-top:1px solid #C9A372;text-align:center;font-size:11px;color:#6c757d;letter-spacing:0.05em;\">\n"
