msgstr "バッチ"

#. module: eh_account_sepa_ct
#. odoo-python
#: code:addons/eh_account_sepa_ct/models/batch_payment.py:0
msgid "Batch contains no posted payments to export."
msgstr "バッチにはエクスポートする記帳済みの支払いがありません。"

#. module: eh_account_sepa_ct
#. odoo-python
#: code:addons/eh_account_sepa_ct/models/batch_payment.py:0
msgid ""
"Batch contains payments in %(count)s different currencies (%(names)s). Split"
" the batch by currency before exporting; SEPA Credit Transfer requires one "
"currency per file."
msgstr ""
"バッチには %(count)s "
"種類の異なる通貨（%(names)s）の支払いが含まれています。エクスポート前に通貨ごとにバッチを分割してください。SEPA Credit "
"Transfer ではファイルごとに 1 つの通貨が必要です。"

#. module: eh_account_sepa_ct
#: model:ir.model,name:eh_account_sepa_ct.model_eh_batch_payment
msgid "Batch payment"
msgstr "バッチ支払い"

