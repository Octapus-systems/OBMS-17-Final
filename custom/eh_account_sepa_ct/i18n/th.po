#. module: eh_account_sepa_ct
#. odoo-javascript
#: code:addons/eh_account_sepa_ct/static/src/js/tours/sepa_ct_tour.js:0
msgid ""
"Third: open <b>Batch Payments</b>, create an outbound batch, attach the "
"vendor payments you want to bundle, and post it. Posting a batch locks the "
"line set so the SEPA file matches exactly what the GL sees."
msgstr ""
"ขั้นที่สาม: เปิด <b>Batch Payments</b> สร้างชุดจ่ายขาออก "
"แนบการชำระเงินผู้ขายที่คุณต้องการรวม และลงบัญชี "
"การลงบัญชีชุดจะล็อกชุดบรรทัดเพื่อให้ไฟล์ SEPA ตรงกับสิ่งที่ GL เห็นทุกประการ"

#. module: eh_account_sepa_ct
#: model:ir.model.fields,field_description:eh_account_sepa_ct.field_eh_sepa_export__transaction_count
msgid "Transaction Count"
msgstr "จำนวนธุรกรรม"

