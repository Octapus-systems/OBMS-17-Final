<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            SEPA CT export confirmation. Sent on demand from the
            export form to the AP team mailing list (or any
            recipient) so they can attach the bank-acceptance
            confirmation back to the audit row. Renders against an
            eh.sepa.export so the message id, control sum, and
            transaction count are baked into the body.
        -->

        <record id="email_template_eh_sepa_ct_confirmation" model="mail.template">
            <field name="name">EH SEPA CT — Generation Confirmation</field>
            <field name="model_id" ref="model_eh_sepa_export"/>
            <field name="subject">SEPA file generated — {{ object.message_id }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) | safe }}</field>
            <field name="lang">{{ user.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin:0;padding:0;background-color:#FBF8F2;font-family:'Segoe UI',Roboto,Arial,sans-serif;color:#1A2C3D;">
                    <div style="max-width:640px;margin:0 auto;padding:24px;background-color:#FBF8F2;">
                        <div style="border-top:3px solid #C9A372;padding-top:18px;">
                            <h1 style="margin:0 0 6px 0;font-size:20px;color:#1A2C3D;">
                                SEPA Credit Transfer file generated
                            </h1>
                            <p style="margin:0 0 18px 0;color:#6c757d;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;">
                                <t t-out="object.company_id.name"/>
                            </p>
                        </div>

                        <table style="width:100%;border-collapse:collapse;margin:18px 0;background:#fff;border:1px solid #e1e4e8;border-radius:6px;">
                            <tr>
                                <td style="padding:10px 14px;color:#6c757d;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid #e1e4e8;">
                                    Message ID
                                </td>
                                <td style="padding:10px 14px;font-family:'DM Mono',monospace;border-bottom:1px solid #e1e4e8;text-align:right;"
                                    t-out="object.message_id"/>
                            </tr>
                            <tr>
                                <td style="padding:10px 14px;color:#6c757d;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid #e1e4e8;">
                                    Batch
                                </td>
                                <td style="padding:10px 14px;border-bottom:1px solid #e1e4e8;text-align:right;"
                                    t-out="object.batch_id.name"/>
                            </tr>
                            <tr>
                                <td style="padding:10px 14px;color:#6c757d;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid #e1e4e8;">
                                    Transactions
                                </td>
                                <td style="padding:10px 14px;border-bottom:1px solid #e1e4e8;text-align:right;font-weight:600;"
                                    t-out="object.transaction_count"/>
                            </tr>
                            <tr>
                                <td style="padding:10px 14px;color:#6c757d;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid #e1e4e8;">
                                    Control sum
                                </td>
                                <td style="padding:10px 14px;border-bottom:1px solid #e1e4e8;text-align:right;font-weight:700;"
                                    t-out="'{:,.2f}'.format(object.control_sum or 0.0)"/>
                            </tr>
                            <tr>
                                <td style="padding:10px 14px;color:#6c757d;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;">
                                    SHA-256
                                </td>
                                <td style="padding:10px 14px;font-family:'DM Mono',monospace;font-size:11px;text-align:right;"
                                    t-out="object.file_hash"/>
                            </tr>
                        </table>

                        <p style="margin:0 0 14px 0;font-size:15px;line-height:1.55;">
                            The file is attached. Upload it to the bank
                            portal and forward the bank's acceptance
                            confirmation back to this thread for the
                            audit log.
                        </p>

                        <div style="margin-top:32px;padding-top:14px;border-top:1px solid #C9A372;text-align:center;font-size:11px;color:#6c757d;letter-spacing:0.05em;">
                            ERP Heritage Accounting Suite
                        </div>
                    </div>
                </div>
            </field>
        </record>

    </data>
</odoo>
