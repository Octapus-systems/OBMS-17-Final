<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_consol_run" model="ir.sequence">
            <field name="name">EH Consolidation Run</field>
            <field name="code">eh.consol.run</field>
            <field name="prefix">CONS/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True"/>
        </record>

        <record id="seq_eh_consol_elimination" model="ir.sequence">
            <field name="name">EH Consolidation Elimination</field>
            <field name="code">eh.consol.elimination</field>
            <field name="prefix">ELIM/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True"/>
        </record>

    </data>
</odoo>
