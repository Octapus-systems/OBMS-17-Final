<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Stat-button card on the partner form. Status badge flips colour
        at 80%/100% thresholds so a buyer sees credit risk at a glance.
    -->
    <record id="view_partner_form_eh_credit_button" model="ir.ui.view">
        <field name="name">res.partner.form.eh_credit_button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_eh_credit_status"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        title="Credit status and override history"
                        invisible="eh_credit_status == 'disabled'">
                    <div class="o_stat_info">
                        <field name="eh_credit_status"
                               widget="badge"
                               decoration-success="eh_credit_status == 'ok'"
                               decoration-warning="eh_credit_status == 'warn'"
                               decoration-danger="eh_credit_status == 'over'"/>
                        <span class="o_stat_text">Credit</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_eh_credit" model="ir.ui.view">
        <field name="name">res.partner.form.eh_credit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group string="Credit policy">
                    <group>
                        <field name="eh_credit_limit"
                               widget="monetary"/>
                        <field name="eh_credit_policy_id"
                               options="{'no_create': True}"/>
                        <field name="eh_effective_credit_limit"
                               widget="monetary" readonly="1"/>
                    </group>
                    <group>
                        <field name="eh_credit_exposure"
                               widget="monetary" readonly="1"/>
                        <field name="eh_credit_status" widget="badge"
                               decoration-success="eh_credit_status == 'ok'"
                               decoration-warning="eh_credit_status == 'warn'"
                               decoration-danger="eh_credit_status == 'over'"
                               decoration-muted="eh_credit_status == 'disabled'"/>
                    </group>
                </group>
                <p class="text-muted">
                    Set the limit per partner only when a specific customer needs different terms. Otherwise the company default policy's limit applies. Status flips to Warning above 80 percent of the limit and Over above 100 percent. Posting a customer invoice in Over state requires a manager override unless the policy is in warn-only mode.
                </p>
            </xpath>
        </field>
    </record>

</odoo>
