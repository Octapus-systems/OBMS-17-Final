<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_soce" model="ir.sequence">
            <field name="name">EH SOCE Reference</field>
            <field name="code">eh.soce</field>
            <field name="prefix">SOCE/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_soci" model="ir.sequence">
            <field name="name">EH SOCI Reference</field>
            <field name="code">eh.soci</field>
            <field name="prefix">SOCI/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_statement_tieout" model="ir.sequence">
            <field name="name">EH Statement Tie-Out Reference</field>
            <field name="code">eh.statement.tieout</field>
            <field name="prefix">TIE/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
