<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!-- Structural OCI recycling tags (IAS 1.82A). Applied to the ledger
             OCI reserve accounts; SOCI lines referencing a tagged source
             account derive their reclassification section from the tag. -->
        <record id="tag_eh_oci_recyclable" model="account.account.tag">
            <field name="name">EH OCI Recyclable</field>
            <field name="applicability">accounts</field>
            <field name="color">10</field>
        </record>

        <record id="tag_eh_oci_non_recyclable" model="account.account.tag">
            <field name="name">EH OCI Non-Recyclable</field>
            <field name="applicability">accounts</field>
            <field name="color">1</field>
        </record>

    </data>
</odoo>
