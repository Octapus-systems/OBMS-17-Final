#. module: eh_account_collections
#: model:mail.template,body_html:eh_account_collections.email_template_eh_dunning_friendly
msgid ""
"<div style=\"margin:0;padding:0;background-color:#FBF8F2;font-family:'Segoe UI',Roboto,Arial,sans-serif;color:#1A2C3D;\">\n"
"                    <div style=\"max-width:640px;margin:0 auto;padding:24px;background-color:#FBF8F2;\">\n"
"                        <div style=\"border-top:3px solid #C9A372;padding-top:18px;\">\n"
"                            <h1 style=\"margin:0 0 6px 0;font-size:20px;color:#1A2C3D;\">\n"
"                                A friendly reminder\n"
"                            </h1>\n"
"                            <p style=\"margin:0 0 18px 0;color:#6c757d;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;\">\n"
"                                <t t-out=\"object.company_id.name\"/>\n"
"                            </p>\n"
"                        </div>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Dear <strong t-out=\"object.partner_id.name\"/>,\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            We noticed that an open balance of\n"
"                            <strong t-out=\"'{:,.2f}'.format(object.total_overdue_amount or 0.0)\"/>\n"
"                            <t t-out=\"object.currency_id.symbol or ''\"/> is showing on your account.\n"
"                            The oldest invoice dates back to\n"
"                            <strong t-out=\"object.oldest_overdue_date and object.oldest_overdue_date.strftime('%Y-%m-%d') or ''\"/>.\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            If payment has been issued in the last few days,\n"
"                            please ignore this message — our records may\n"
"                            simply be a couple of days behind. Otherwise,\n"
"                            we'd appreciate it if you could settle the\n"
"                            balance at your earliest convenience.\n"
"                        </p>\n"
"                        <p style=\"margin:18px 0 0 0;font-size:15px;line-height:1.55;\">\n"
"                            Thank you,<br/>\n"
"                            <strong t-out=\"object.company_id.name\"/>\n"
"                        </p>\n"
"                        <div style=\"margin-top:32px;padding-top:14px;border-top:1px solid #C9A372;text-align:center;font-size:11px;color:#6c757d;letter-spacing:0.05em;\">\n"
"                            ERP Heritage Accounting Suite\n"
"                        </div>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:0;background-color:#FBF8F2;font-family:'Segoe UI',Roboto,Arial,sans-serif;color:#1A2C3D;\">\n"
"                    <div style=\"max-width:640px;margin:0 auto;padding:24px;background-color:#FBF8F2;\">\n"
"                        <div style=\"border-top:3px solid #C9A372;padding-top:18px;\">\n"
"                            <h1 style=\"margin:0 0 6px 0;font-size:20px;color:#1A2C3D;\">\n"
"                                Een vriendelijke herinnering\n"
"                            </h1>\n"
"                            <p style=\"margin:0 0 18px 0;color:#6c757d;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;\">\n"
"                                <t t-out=\"object.company_id.name\"/>\n"
"                            </p>\n"
"                        </div>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Beste <strong t-out=\"object.partner_id.name\"/>,\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            We hebben gemerkt dat er een openstaand saldo van\n"
"                            <strong t-out=\"'{:,.2f}'.format(object.total_overdue_amount or 0.0)\"/>\n"
"                            <t t-out=\"object.currency_id.symbol or ''\"/> op uw rekening staat. De oudste factuur dateert van\n"
"                            <strong t-out=\"object.oldest_overdue_date and object.oldest_overdue_date.strftime('%Y-%m-%d') or ''\"/>.\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Als de betaling in de afgelopen dagen is verricht, kunt u dit bericht negeren — onze administratie loopt mogelijk slechts enkele dagen achter. Anders zouden we het op prijs stellen als u het saldo zo spoedig mogelijk voldoet.\n"
"                        </p>\n"
"                        <p style=\"margin:18px 0 0 0;font-size:15px;line-height:1.55;\">\n"
"                            Bedankt,<br/>\n"
"                            <strong t-out=\"object.company_id.name\"/>\n"
"                        </p>\n"
"                        <div style=\"margin-top:32px;padding-top:14px;border-top:1px solid #C9A372;text-align:center;font-size:11px;color:#6c757d;letter-spacing:0.05em;\">\n"
"                            ERP Heritage Accounting Suite\n"
"                        </div>\n"
"                    </div>\n"
"                </div>"

#. module: eh_account_collections
#: model:mail.template,body_html:eh_account_collections.email_template_eh_dunning_final
msgid ""
"<div style=\"margin:0;padding:0;background-color:#FBF8F2;font-family:'Segoe UI',Roboto,Arial,sans-serif;color:#1A2C3D;\">\n"
"                    <div style=\"max-width:640px;margin:0 auto;padding:24px;background-color:#FBF8F2;\">\n"
"                        <div style=\"border-top:3px solid #dc3545;padding-top:18px;\">\n"
"                            <h1 style=\"margin:0 0 6px 0;font-size:20px;color:#1A2C3D;\">\n"
"                                Final notice\n"
"                            </h1>\n"
"                            <p style=\"margin:0 0 18px 0;color:#721c24;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;font-weight:700;\">\n"
"                                Before external referral\n"
"                            </p>\n"
"                        </div>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Dear <strong t-out=\"object.partner_id.name\"/>,\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Despite our prior reminders, the balance of\n"
"                            <strong t-out=\"'{:,.2f}'.format(object.total_overdue_amount or 0.0)\"/>\n"
"                            <t t-out=\"object.currency_id.symbol or ''\"/> remains\n"
"                            unpaid and is now\n"
"                            <strong t-out=\"object.days_overdue_max or 0\"/> days overdue.\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            This is our final notice before we refer the\n"
"                            matter externally for collection. We strongly\n"
"                            encourage you to settle this balance, or to\n"
"                            contact us within 7 days to make alternative\n"
"                            arrangements.\n"
"                        </p>\n"
"                        <p style=\"margin:18px 0 0 0;font-size:15px;line-height:1.55;\">\n"
"                            Sincerely,<br/>\n"
"                            <strong t-out=\"object.company_id.name\"/>\n"
"                        </p>\n"
"                        <div style=\"margin-top:32px;padding-top:14px;border-top:1px solid #C9A372;text-align:center;font-size:11px;color:#6c757d;letter-spacing:0.05em;\">\n"
"                            ERP Heritage Accounting Suite\n"
"                        </div>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:0;background-color:#FBF8F2;font-family:'Segoe UI',Roboto,Arial,sans-serif;color:#1A2C3D;\">\n"
"                    <div style=\"max-width:640px;margin:0 auto;padding:24px;background-color:#FBF8F2;\">\n"
"                        <div style=\"border-top:3px solid #dc3545;padding-top:18px;\">\n"
"                            <h1 style=\"margin:0 0 6px 0;font-size:20px;color:#1A2C3D;\">\n"
"                                Laatste aanmaning\n"
"                            </h1>\n"
"                            <p style=\"margin:0 0 18px 0;color:#721c24;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;font-weight:700;\">\n"
"                                Vóór externe overdracht\n"
"                            </p>\n"
"                        </div>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Beste <strong t-out=\"object.partner_id.name\"/>,\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Ondanks onze eerdere herinneringen blijft het saldo van\n"
"                            <strong t-out=\"'{:,.2f}'.format(object.total_overdue_amount or 0.0)\"/>\n"
"                            <t t-out=\"object.currency_id.symbol or ''\"/> onbetaald en is nu\n"
"                            <strong t-out=\"object.days_overdue_max or 0\"/> dagen te laat.\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Dit is onze laatste aanmaning voordat wij de zaak extern overdragen voor incasso. Wij raden u dringend aan dit saldo te voldoen, of binnen 7 dagen contact met ons op te nemen om een alternatieve regeling te treffen.\n"
"                        </p>\n"
"                        <p style=\"margin:18px 0 0 0;font-size:15px;line-height:1.55;\">\n"
"                            Hoogachtend,<br/>\n"
"                            <strong t-out=\"object.company_id.name\"/>\n"
"                        </p>\n"
"                        <div style=\"margin-top:32px;padding-top:14px;border-top:1px solid #C9A372;text-align:center;font-size:11px;color:#6c757d;letter-spacing:0.05em;\">\n"
"                            ERP Heritage Accounting Suite\n"
"                        </div>\n"
"                    </div>\n"
"                </div>"

#. module: eh_account_collections
#: model:mail.template,body_html:eh_account_collections.email_template_eh_dunning_firm
msgid ""
"<div style=\"margin:0;padding:0;background-color:#FBF8F2;font-family:'Segoe UI',Roboto,Arial,sans-serif;color:#1A2C3D;\">\n"
"                    <div style=\"max-width:640px;margin:0 auto;padding:24px;background-color:#FBF8F2;\">\n"
"                        <div style=\"border-top:3px solid #ffc107;padding-top:18px;\">\n"
"                            <h1 style=\"margin:0 0 6px 0;font-size:20px;color:#1A2C3D;\">\n"
"                                Action required\n"
"                            </h1>\n"
"                            <p style=\"margin:0 0 18px 0;color:#856404;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;font-weight:600;\">\n"
"                                Overdue balance\n"
"                            </p>\n"
"                        </div>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Dear <strong t-out=\"object.partner_id.name\"/>,\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Our previous reminder appears to have gone\n"
"                            unanswered. The balance of\n"
"                            <strong t-out=\"'{:,.2f}'.format(object.total_overdue_amount or 0.0)\"/>\n"
"                            <t t-out=\"object.currency_id.symbol or ''\"/> is now\n"
"                            <strong t-out=\"object.days_overdue_max or 0\"/> days past due.\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Please arrange payment or contact us to discuss\n"
"                            a payment plan within the next 7 days. Continued\n"
"                            non-payment may result in late fees and could\n"
"                            affect future credit terms.\n"
"                        </p>\n"
"                        <p style=\"margin:18px 0 0 0;font-size:15px;line-height:1.55;\">\n"
"                            Sincerely,<br/>\n"
"                            <strong t-out=\"object.company_id.name\"/>\n"
"                        </p>\n"
"                        <div style=\"margin-top:32px;padding-top:14px;border-top:1px solid #C9A372;text-align:center;font-size:11px;color:#6c757d;letter-spacing:0.05em;\">\n"
"                            ERP Heritage Accounting Suite\n"
"                        </div>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:0;background-color:#FBF8F2;font-family:'Segoe UI',Roboto,Arial,sans-serif;color:#1A2C3D;\">\n"
"                    <div style=\"max-width:640px;margin:0 auto;padding:24px;background-color:#FBF8F2;\">\n"
"                        <div style=\"border-top:3px solid #ffc107;padding-top:18px;\">\n"
"                            <h1 style=\"margin:0 0 6px 0;font-size:20px;color:#1A2C3D;\">\n"
"                                Actie vereist\n"
"                            </h1>\n"
"                            <p style=\"margin:0 0 18px 0;color:#856404;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;font-weight:600;\">\n"
"                                Achterstallig saldo\n"
"                            </p>\n"
"                        </div>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Beste <strong t-out=\"object.partner_id.name\"/>,\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Onze vorige herinnering lijkt onbeantwoord te zijn gebleven. Het saldo van\n"
"                            <strong t-out=\"'{:,.2f}'.format(object.total_overdue_amount or 0.0)\"/>\n"
"                            <t t-out=\"object.currency_id.symbol or ''\"/> is nu\n"
"                            <strong t-out=\"object.days_overdue_max or 0\"/> dagen te laat.\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 14px 0;font-size:15px;line-height:1.55;\">\n"
"                            Regel de betaling of neem binnen de komende 7 dagen contact met ons op om een betalingsregeling te bespreken. Aanhoudende niet-betaling kan leiden tot te-latekosten en kan van invloed zijn op toekomstige kredietvoorwaarden.\n"
"                        </p>\n"
"                        <p style=\"margin:18px 0 0 0;font-size:15px;line-height:1.55;\">\n"
"                            Hoogachtend,<br/>\n"
"                            <strong t-out=\"object.company_id.name\"/>\n"
"                        </p>\n"
"                        <div style=\"margin-top:32px;padding-top:14px;border-top:1px solid #C9A372;text-align:center;font-size:11px;color:#6c757d;letter-spacing:0.05em;\">\n"
"                            ERP Heritage Accounting Suite\n"
"                        </div>\n"
"                    </div>\n"
"                </div>"

#. module: eh_account_collections
#: model:mail.template,body_html:eh_account_collections.mail_template_followup_final
msgid ""
"<div>\n"
"                    <p>Dear <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                    <p>\n"
"                        Despite previous reminders, the balance of\n"
"                        <strong>\n"
"                            <t t-out=\"format_amount(object.total_overdue_amount, object.currency_id)\"/>\n"
"                        </strong>\n"
"                        on your account remains unpaid. The oldest item\n"
"                        has been outstanding since\n"
"                        <t t-out=\"format_date(object.oldest_overdue_date)\"/>.\n"
"                    </p>\n"
"                    <p>\n"
"                        This is the final notice before the case is\n"
"                        escalated for collection. Please contact us\n"
"                        within seven days to settle the balance or\n"
"                        agree a payment plan.\n"
"                    </p>\n"
"                    <p>\n"
"                        Regards,<br/>\n"
"                        <t t-out=\"object.collector_id.name or object.company_id.name\"/>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Beste <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                    <p>\n"
"                        Ondanks eerdere herinneringen is het saldo van\n"
"                        <strong>\n"
"                            <t t-out=\"format_amount(object.total_overdue_amount, object.currency_id)\"/>\n"
"                        </strong>\n"
"                        op uw rekening nog steeds onbetaald. Het oudste item staat open sinds\n"
"                        <t t-out=\"format_date(object.oldest_overdue_date)\"/>.\n"
"                    </p>\n"
"                    <p>\n"
"                        Dit is de laatste aanmaning voordat de zaak wordt overgedragen aan incasso. Neem binnen zeven dagen contact met ons op om het saldo te voldoen of een betalingsregeling af te spreken.\n"
"                    </p>\n"
"                    <p>\n"
"                        Met vriendelijke groet,<br/>\n"
"                        <t t-out=\"object.collector_id.name or object.company_id.name\"/>\n"
"                    </p>\n"
"                </div>"

#. module: eh_account_collections
#: model:mail.template,body_html:eh_account_collections.mail_template_followup_reminder_2
msgid ""
"<div>\n"
"                    <p>Hi <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                    <p>\n"
"                        We have not received payment on outstanding\n"
"                        invoices totalling\n"
"                        <strong>\n"
"                            <t t-out=\"format_amount(object.total_overdue_amount, object.currency_id)\"/>\n"
"                        </strong>.\n"
"                        The oldest item has been due since\n"
"                        <t t-out=\"format_date(object.oldest_overdue_date)\"/>\n"
"                        (<t t-out=\"object.days_overdue_max\"/> days overdue).\n"
"                    </p>\n"
"                    <p>\n"
"                        Please settle the balance within the next seven\n"
"                        days, or reply to this email to arrange a\n"
"                        payment plan if you are facing difficulty.\n"
"                    </p>\n"
"                    <p>\n"
"                        Kind regards,<br/>\n"
"                        <t t-out=\"object.collector_id.name or object.company_id.name\"/>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Hallo <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                    <p>\n"
"                        Wij hebben geen betaling ontvangen voor openstaande facturen met een totaal van\n"
"                        <strong>\n"
"                            <t t-out=\"format_amount(object.total_overdue_amount, object.currency_id)\"/>\n"
"                        </strong>.\n"
"                        Het oudste item is vervallen sinds\n"
"                        <t t-out=\"format_date(object.oldest_overdue_date)\"/>\n"
"                        (<t t-out=\"object.days_overdue_max\"/> dagen te laat).\n"
"                    </p>\n"
"                    <p>\n"
"                        Voldoe het saldo binnen de komende zeven dagen, of beantwoord deze e-mail om een betalingsregeling te treffen als u in de problemen zit.\n"
"                    </p>\n"
"                    <p>\n"
"                        Met vriendelijke groet,<br/>\n"
"                        <t t-out=\"object.collector_id.name or object.company_id.name\"/>\n"
"                    </p>\n"
"                </div>"

#. module: eh_account_collections
#: model:mail.template,body_html:eh_account_collections.mail_template_followup_reminder_1
msgid ""
"<div>\n"
"                    <p>Hi <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                    <p>\n"
"                        We notice an outstanding balance of\n"
"                        <strong>\n"
"                            <t t-out=\"format_amount(object.total_overdue_amount, object.currency_id)\"/>\n"
"                        </strong>\n"
"                        on your account, with the oldest item due on\n"
"                        <t t-out=\"format_date(object.oldest_overdue_date)\"/>.\n"
"                    </p>\n"
"                    <p>\n"
"                        If you have already settled the balance, please\n"
"                        ignore this note. Otherwise, please arrange\n"
"                        payment at your earliest convenience or reply to\n"
"                        this email if you have any questions.\n"
"                    </p>\n"
"                    <p>\n"
"                        Kind regards,<br/>\n"
"                        <t t-out=\"object.collector_id.name or object.company_id.name\"/>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Hallo <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                    <p>\n"
"                        Wij zien een openstaand saldo van\n"
"                        <strong>\n"
"                            <t t-out=\"format_amount(object.total_overdue_amount, object.currency_id)\"/>\n"
"                        </strong>\n"
"                        op uw rekening, met het oudste item vervallen op\n"
"                        <t t-out=\"format_date(object.oldest_overdue_date)\"/>.\n"
"                    </p>\n"
"                    <p>\n"
"                        Als u het saldo al hebt voldaan, kunt u dit bericht negeren. Zorg anders zo spoedig mogelijk voor betaling, of beantwoord deze e-mail als u vragen hebt.\n"
"                    </p>\n"
"                    <p>\n"
"                        Met vriendelijke groet,<br/>\n"
"                        <t t-out=\"object.collector_id.name or object.company_id.name\"/>\n"
"                    </p>\n"
"                </div>"

