msgstr "Стадии"

#. module: eh_account_collections
#: model_terms:ir.ui.view,arch_db:eh_account_collections.report_case_statement
msgid "Statement of Account"
msgstr "Выписка по счёту"

#. module: eh_account_collections
#: model:ir.model.fields,help:eh_account_collections.field_eh_collections_case__activity_state
msgid ""
"Status based on activities\n"
"Overdue: Due date is already passed\n"
"Today: Activity date is today\n"
"Planned: Future activities."
msgstr ""
"Статус, основанный на мероприятии\n"
"Просроченная: Дата, уже прошла\n"
"Сегодня: Дата мероприятия сегодня\n"
"Запланировано: будущая деятельность."

