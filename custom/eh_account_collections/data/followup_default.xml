<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            Three default mail templates: courteous reminder at 7 days,
            firm reminder at 30, final notice at 60. Each renders the
            partner's display name and the case's total_overdue_amount /
            oldest_overdue_date so the customer reads a personal note,
            not a form letter.
        -->

        <record id="mail_template_followup_reminder_1" model="mail.template">
            <field name="name">Collections: Reminder 1</field>
            <field name="model_id" ref="model_eh_collections_case"/>
            <field name="subject">Friendly reminder: outstanding invoices</field>
            <field name="email_from">{{ object.collector_id.email_formatted or (object.company_id.partner_id and object.company_id.partner_id.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hi <t t-out="object.partner_id.name"/>,</p>
                    <p>
                        We notice an outstanding balance of
                        <strong>
                            <t t-out="format_amount(object.total_overdue_amount, object.currency_id)"/>
                        </strong>
                        on your account, with the oldest item due on
                        <t t-out="format_date(object.oldest_overdue_date)"/>.
                    </p>
                    <p>
                        If you have already settled the balance, please
                        ignore this note. Otherwise, please arrange
                        payment at your earliest convenience or reply to
                        this email if you have any questions.
                    </p>
                    <p>
                        Kind regards,<br/>
                        <t t-out="object.collector_id.name or object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <record id="mail_template_followup_reminder_2" model="mail.template">
            <field name="name">Collections: Reminder 2</field>
            <field name="model_id" ref="model_eh_collections_case"/>
            <field name="subject">Second reminder: invoices past due</field>
            <field name="email_from">{{ object.collector_id.email_formatted or (object.company_id.partner_id and object.company_id.partner_id.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hi <t t-out="object.partner_id.name"/>,</p>
                    <p>
                        We have not received payment on outstanding
                        invoices totalling
                        <strong>
                            <t t-out="format_amount(object.total_overdue_amount, object.currency_id)"/>
                        </strong>.
                        The oldest item has been due since
                        <t t-out="format_date(object.oldest_overdue_date)"/>
                        (<t t-out="object.days_overdue_max"/> days overdue).
                    </p>
                    <p>
                        Please settle the balance within the next seven
                        days, or reply to this email to arrange a
                        payment plan if you are facing difficulty.
                    </p>
                    <p>
                        Kind regards,<br/>
                        <t t-out="object.collector_id.name or object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <record id="mail_template_followup_final" model="mail.template">
            <field name="name">Collections: Final Notice</field>
            <field name="model_id" ref="model_eh_collections_case"/>
            <field name="subject">Final notice before escalation</field>
            <field name="email_from">{{ object.collector_id.email_formatted or (object.company_id.partner_id and object.company_id.partner_id.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Dear <t t-out="object.partner_id.name"/>,</p>
                    <p>
                        Despite previous reminders, the balance of
                        <strong>
                            <t t-out="format_amount(object.total_overdue_amount, object.currency_id)"/>
                        </strong>
                        on your account remains unpaid. The oldest item
                        has been outstanding since
                        <t t-out="format_date(object.oldest_overdue_date)"/>.
                    </p>
                    <p>
                        This is the final notice before the case is
                        escalated for collection. Please contact us
                        within seven days to settle the balance or
                        agree a payment plan.
                    </p>
                    <p>
                        Regards,<br/>
                        <t t-out="object.collector_id.name or object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!--
            Default ladder. Companies that want a different cadence edit
            the days_overdue / delay_days here or duplicate the records.
            The escalation step is terminal: cases that reach it stop
            auto-advancing and a manager picks up the case.
        -->

        <record id="followup_level_1" model="eh.collections.followup.level">
            <field name="name">Reminder 1 (7 days)</field>
            <field name="sequence">10</field>
            <field name="days_overdue">7</field>
            <field name="action_type">email</field>
            <field name="mail_template_id" ref="mail_template_followup_reminder_1"/>
            <field name="delay_days">14</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="followup_level_2" model="eh.collections.followup.level">
            <field name="name">Reminder 2 (30 days)</field>
            <field name="sequence">20</field>
            <field name="days_overdue">30</field>
            <field name="action_type">email_and_activity</field>
            <field name="mail_template_id" ref="mail_template_followup_reminder_2"/>
            <field name="activity_summary">Call the customer about outstanding balance</field>
            <field name="activity_offset_days">2</field>
            <field name="delay_days">21</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="followup_level_3" model="eh.collections.followup.level">
            <field name="name">Final notice (60 days)</field>
            <field name="sequence">30</field>
            <field name="days_overdue">60</field>
            <field name="action_type">email_and_activity</field>
            <field name="mail_template_id" ref="mail_template_followup_final"/>
            <field name="activity_summary">Final follow-up call before escalation</field>
            <field name="activity_offset_days">2</field>
            <field name="delay_days">14</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="followup_level_4_escalate" model="eh.collections.followup.level">
            <field name="name">Escalate to legal (90 days)</field>
            <field name="sequence">40</field>
            <field name="days_overdue">90</field>
            <field name="action_type">escalate</field>
            <field name="escalate_to_stage_id" ref="stage_escalated"/>
            <field name="is_terminal" eval="True"/>
            <field name="delay_days">0</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

    </data>
</odoo>
