<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_benefit_valuation" model="ir.sequence">
            <field name="name">EH Benefit Valuation Reference</field>
            <field name="code">eh.benefit.valuation</field>
            <field name="prefix">DBV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_benefit_dc_accrual" model="ir.sequence">
            <field name="name">EH DC Accrual Reference</field>
            <field name="code">eh.benefit.dc.accrual</field>
            <field name="prefix">DCA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
