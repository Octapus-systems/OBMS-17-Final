<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- ===================== eh.benefit.plan ===================== -->

    <record id="view_eh_benefit_plan_list" model="ir.ui.view">
        <field name="name">eh.benefit.plan.list</field>
        <field name="model">eh.benefit.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="country_note" optional="show"/>
                <field name="funded"/>
                <field name="latest_closing_dbo" widget="monetary" optional="show"/>
                <field name="latest_closing_assets" widget="monetary" optional="show"/>
                <field name="latest_recognised_position" widget="monetary" optional="show"/>
                <field name="valuation_count" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_benefit_plan_form" model="ir.ui.view">
        <field name="name">eh.benefit.plan.form</field>
        <field name="model">eh.benefit.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="eh_account_base.group_eh_user"/>
                    <button name="action_close" type="object"
                            string="Close"
                            invisible="state != 'active'"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_reopen" type="object"
                            string="Reopen"
                            invisible="state != 'closed'"
                            groups="eh_account_base.group_eh_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,closed" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_valuations" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="valuation_count" widget="statinfo"
                                   string="Valuations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Group Pension Plan"/></h1>
                    </div>
                    <group>
                        <group string="Plan">
                            <field name="country_note"/>
                            <field name="funded"/>
                            <field name="contributions_posted_elsewhere"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Latest Posted Position">
                            <field name="latest_closing_dbo" widget="monetary" readonly="1"/>
                            <field name="latest_closing_assets" widget="monetary" readonly="1"/>
                            <field name="latest_net_liability" widget="monetary" readonly="1"/>
                            <field name="latest_recognised_position" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <group string="Accounts">
                        <group>
                            <field name="service_cost_account_id"/>
                            <field name="net_interest_account_id"/>
                            <field name="oci_account_id"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="dbo_account_id"/>
                            <field name="plan_asset_account_id"
                                   invisible="not funded"/>
                            <field name="contribution_account_id"
                                   invisible="not funded"/>
                            <field name="benefit_payment_account_id"
                                   invisible="funded"/>
                        </group>
                    </group>
                    <group string="Valuation Rollforward (IAS 19.140-141)">
                        <field name="valuation_ids" nolabel="1" colspan="2" readonly="1">
                            <tree>
                                <field name="period_end"/>
                                <field name="opening_dbo" widget="monetary"/>
                                <field name="closing_dbo" widget="monetary"/>
                                <field name="opening_assets" widget="monetary"/>
                                <field name="closing_assets" widget="monetary"/>
                                <field name="oci_remeasurement" widget="monetary"/>
                                <field name="pnl_total" widget="monetary"/>
                                <field name="recognised_net_position" widget="monetary"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'posted'"
                                       decoration-muted="state == 'reversed'"/>
                            </tree>
                        </field>
                    </group>
                    <group>
                        <field name="notes" nolabel="1" colspan="2"
                               placeholder="Plan terms, actuary, valuation cadence..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="action_eh_benefit_plan" model="ir.actions.act_window">
        <field name="name">Benefit Plans</field>
        <field name="res_model">eh.benefit.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first benefit plan</p>
            <p>Set up a defined benefit or funded plan here, wire its accounts and journal, then record valuations against it to track the IAS 19 net position.</p>
        </field>
    </record>

    <!-- ===================== eh.benefit.valuation ===================== -->

    <record id="view_eh_benefit_valuation_list" model="ir.ui.view">
        <field name="name">eh.benefit.valuation.list</field>
        <field name="model">eh.benefit.valuation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="period_end"/>
                <field name="opening_dbo" widget="monetary" optional="hide"/>
                <field name="closing_dbo" widget="monetary" optional="show"/>
                <field name="closing_assets" widget="monetary" optional="show"/>
                <field name="oci_remeasurement" widget="monetary" optional="show"/>
                <field name="pnl_total" widget="monetary" optional="show"/>
                <field name="recognised_net_position" widget="monetary" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'reversed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_benefit_valuation_form" model="ir.ui.view">
        <field name="name">eh.benefit.valuation.form</field>
        <field name="model">eh.benefit.valuation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object"
                            string="Post" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_reverse" type="object"
                            string="Reverse"
                            invisible="state != 'posted'"
                            groups="eh_account_base.group_eh_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="move_count" widget="statinfo"
                                   string="Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Period">
                            <field name="plan_id"
                                   readonly="state != 'draft'"/>
                            <field name="plan_funded" invisible="1"/>
                            <field name="period_end"
                                   readonly="state != 'draft'"/>
                            <field name="discount_rate"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Opening Position">
                            <field name="opening_dbo" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="opening_assets" widget="monetary"
                                   readonly="state != 'draft'"
                                   invisible="not plan_funded"/>
                            <field name="opening_ceiling_effect" widget="monetary"
                                   readonly="state != 'draft'"
                                   invisible="not plan_funded"/>
                        </group>
                    </group>
                    <group string="Actuarial Inputs (imported, never computed here)">
                        <group>
                            <field name="current_service_cost" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="past_service_cost" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="benefits_paid" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="contributions_employer" widget="monetary"
                                   readonly="state != 'draft'"
                                   invisible="not plan_funded"/>
                        </group>
                        <group>
                            <field name="actuarial_gain_loss_dbo" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="return_on_assets_excess" widget="monetary"
                                   readonly="state != 'draft'"
                                   invisible="not plan_funded"/>
                        </group>
                    </group>
                    <group string="Settlements (IAS 19.109-112)">
                        <group>
                            <field name="settlement_dbo_released" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="settlement_payment" widget="monetary"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="settlement_gain_loss" widget="monetary"
                                   readonly="1"/>
                        </group>
                    </group>
                    <group string="Asset Ceiling (IAS 19.64)"
                           invisible="not plan_funded">
                        <group>
                            <field name="apply_asset_ceiling"
                                   readonly="state != 'draft'"/>
                            <field name="asset_ceiling" widget="monetary"
                                   readonly="state != 'draft'"
                                   invisible="not apply_asset_ceiling"/>
                        </group>
                        <group>
                            <field name="ceiling_effect" widget="monetary" readonly="1"/>
                            <field name="ceiling_effect_delta" widget="monetary" readonly="1"/>
                            <field name="recognised_asset" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <group string="Computed Mechanics">
                        <group>
                            <field name="interest_cost" widget="monetary" readonly="1"/>
                            <field name="interest_income" widget="monetary" readonly="1"
                                   invisible="not plan_funded"/>
                            <field name="net_interest" widget="monetary" readonly="1"/>
                            <field name="service_cost_total" widget="monetary" readonly="1"/>
                            <field name="pnl_total" widget="monetary" readonly="1"/>
                            <field name="oci_remeasurement" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="closing_dbo" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="closing_assets" widget="monetary"
                                   readonly="state != 'draft'"
                                   invisible="not plan_funded"/>
                            <field name="net_liability" widget="monetary" readonly="1"/>
                            <field name="recognised_net_position" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" nolabel="1" colspan="2"
                               placeholder="Actuary report reference, assumptions summary, source of the discount rate..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="eh_account_employee_benefits_benefit_valuation_view_graph" model="ir.ui.view">
        <field name="name">eh.benefit.valuation.graph</field>
        <field name="model">eh.benefit.valuation</field>
        <field name="arch" type="xml">
            <graph string="Benefit Valuations" sample="1">
                <field name="period_end" interval="year"/>
                <field name="plan_id"/>
                <field name="closing_dbo" type="measure"/>
                <field name="closing_assets" type="measure"/>
                <field name="pnl_total" type="measure"/>
                <field name="oci_remeasurement" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="eh_account_employee_benefits_benefit_valuation_view_pivot" model="ir.ui.view">
        <field name="name">eh.benefit.valuation.pivot</field>
        <field name="model">eh.benefit.valuation</field>
        <field name="arch" type="xml">
            <pivot string="Benefit Valuations" sample="1">
                <field name="plan_id" type="row"/>
                <field name="period_end" interval="year" type="col"/>
                <field name="closing_dbo" type="measure"/>
                <field name="closing_assets" type="measure"/>
                <field name="pnl_total" type="measure"/>
                <field name="oci_remeasurement" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_eh_benefit_valuation" model="ir.actions.act_window">
        <field name="name">Benefit Valuations</field>
        <field name="res_model">eh.benefit.valuation</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first valuation</p>
            <p>Capture a period-end actuarial position for a benefit plan, then post it to book the service cost, net interest, and OCI remeasurement under IAS 19.</p>
        </field>
    </record>

    <!-- ===================== eh.benefit.dc.accrual ===================== -->

    <record id="view_eh_benefit_dc_accrual_list" model="ir.ui.view">
        <field name="name">eh.benefit.dc.accrual.list</field>
        <field name="model">eh.benefit.dc.accrual</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="period_date"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'reversed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_benefit_dc_accrual_form" model="ir.ui.view">
        <field name="name">eh.benefit.dc.accrual.form</field>
        <field name="model">eh.benefit.dc.accrual</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object"
                            string="Post" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_reverse" type="object"
                            string="Reverse"
                            invisible="state != 'posted'"
                            groups="eh_account_base.group_eh_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="move_count" widget="statinfo"
                                   string="Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_date"
                                   readonly="state != 'draft'"/>
                            <field name="amount" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="expense_account_id"
                                   readonly="state != 'draft'"/>
                            <field name="payable_account_id"
                                   readonly="state != 'draft'"/>
                            <field name="journal_id"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" nolabel="1" colspan="2"
                               placeholder="Plan, employee population, basis of the contribution..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="action_eh_benefit_dc_accrual" model="ir.actions.act_window">
        <field name="name">DC Contribution Accruals</field>
        <field name="res_model">eh.benefit.dc.accrual</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first contribution accrual</p>
            <p>Accrue a period defined contribution expense against the payable and expense accounts, then post it to book the journal entry.</p>
        </field>
    </record>

</odoo>
