<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_close_checklist_tree" model="ir.ui.view">
        <field name="name">eh.close.checklist.list</field>
        <field name="model">eh.close.checklist</field>
        <field name="arch" type="xml">
            <tree string="Close Checklists" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="task_template_count"/>
                <field name="run_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_close_checklist_form" model="ir.ui.view">
        <field name="name">eh.close.checklist.form</field>
        <field name="model">eh.close.checklist</field>
        <field name="arch" type="xml">
            <form string="Close Checklist">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_runs"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list-ul">
                            <field name="run_count"
                                   widget="statinfo"
                                   string="Runs"/>
                        </button>
                    </div>
                    <h1>
                        <field name="name"
                               placeholder="Standard Monthly Close"/>
                    </h1>
                    <group string="Definition">
                        <field name="code"
                               placeholder="standard_close"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id"
                               groups="base.group_multi_company"/>
                    </group>
                    <field name="description"
                           placeholder="Optional description of when to use this checklist."/>
                    <notebook>
                        <page string="Tasks">
                            <field name="task_template_ids">
                                <tree editable="bottom">
                                    <field name="sequence"
                                           widget="handle"/>
                                    <field name="name"/>
                                    <field name="responsible_role"/>
                                    <field name="is_required"
                                           widget="boolean_toggle"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <h1>
                                            <field name="name"
                                                   placeholder="Task name"/>
                                        </h1>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="responsible_role"/>
                                            <field name="is_required"/>
                                        </group>
                                        <field name="description"
                                               placeholder="Optional detailed instructions."/>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_close_checklist" model="ir.actions.act_window">
        <field name="name">Close Checklists</field>
        <field name="res_model">eh.close.checklist</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first close checklist</p>
            <p>Build a reusable list of period-close tasks here, then instantiate it for each period from Close Runs. Click New to define the checklist and add its ordered tasks.</p>
        </field>
    </record>

</odoo>
