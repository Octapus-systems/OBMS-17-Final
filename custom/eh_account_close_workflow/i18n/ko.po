#. module: eh_account_close_workflow
#: model:ir.model.fields,help:eh_account_close_workflow.field_eh_close_run__has_failed_blocking_checks
msgid "True when a blocking automated check is in 'fail' status."
msgstr "차단성 자동 검사가 'fail' 상태일 때 True입니다."

#. module: eh_account_close_workflow
#: model:ir.model.fields,help:eh_account_close_workflow.field_eh_close_run__activity_exception_decoration
