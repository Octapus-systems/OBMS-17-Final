<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            Demo close run and a handful of task instances. The run is
            shown 'in_progress' so the user can see what an active close
            kanban looks like. Tasks model the typical month-end split:
            two done, one in progress, one blocked, one pending.
        -->

        <record id="demo_close_run" model="eh.close.run">
            <field name="name" eval="(DateTime.today().replace(day=1) + relativedelta(days=-1)).strftime('%B %Y') + ' Close'"/>
            <field name="checklist_id" ref="eh_account_close_workflow.checklist_standard_close"/>
            <field name="period_from" eval="(DateTime.today().replace(day=1) + relativedelta(months=-1)).strftime('%Y-%m-%d')"/>
            <field name="period_to" eval="(DateTime.today().replace(day=1) + relativedelta(days=-1)).strftime('%Y-%m-%d')"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="state">in_progress</field>
            <field name="notes">Demo close run for the prior month. Shows a typical state mid-close: a few tasks done, one in progress, one blocked.</field>
        </record>

        <record id="demo_close_task_1" model="eh.close.task">
            <field name="run_id" ref="demo_close_run"/>
            <field name="sequence">10</field>
            <field name="name">Reconcile all bank statements</field>
            <field name="responsible_role">accountant</field>
            <field name="state">done</field>
            <field name="is_required" eval="True"/>
        </record>

        <record id="demo_close_task_2" model="eh.close.task">
            <field name="run_id" ref="demo_close_run"/>
            <field name="sequence">20</field>
            <field name="name">Verify and post recurring journal entries</field>
            <field name="responsible_role">accountant</field>
            <field name="state">done</field>
            <field name="is_required" eval="True"/>
        </record>

        <record id="demo_close_task_3" model="eh.close.task">
            <field name="run_id" ref="demo_close_run"/>
            <field name="sequence">30</field>
            <field name="name">Review aged receivables</field>
            <field name="responsible_role">accountant</field>
            <field name="state">in_progress</field>
            <field name="is_required" eval="True"/>
        </record>

        <record id="demo_close_task_4" model="eh.close.task">
            <field name="run_id" ref="demo_close_run"/>
            <field name="sequence">40</field>
            <field name="name">Resolve unmatched FX revaluation</field>
            <field name="responsible_role">accountant</field>
            <field name="state">blocked</field>
            <field name="is_required" eval="True"/>
            <field name="blocked_reason">Awaiting closing rate from treasury for one currency.</field>
        </record>

        <record id="demo_close_task_5" model="eh.close.task">
            <field name="run_id" ref="demo_close_run"/>
            <field name="sequence">50</field>
            <field name="name">Run Trial Balance and verify</field>
            <field name="responsible_role">accountant</field>
            <field name="state">pending</field>
            <field name="is_required" eval="True"/>
        </record>

    </data>
</odoo>
