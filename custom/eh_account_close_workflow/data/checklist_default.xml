<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="checklist_standard_close" model="eh.close.checklist">
            <field name="name">Standard Monthly Close</field>
            <field name="code">standard_close</field>
            <field name="description">Default checklist covering bank reconciliation, recurring entries, aged AR/AP review, statutory reports, and sign off. Edit or duplicate for cadences other than monthly.</field>
        </record>

        <record id="task_reconcile_bank" model="eh.close.task.template">
            <field name="checklist_id" ref="checklist_standard_close"/>
            <field name="sequence">10</field>
            <field name="name">Reconcile all bank statements</field>
            <field name="responsible_role">accountant</field>
            <field name="description">Every bank journal must show zero unreconciled lines. Run Reconciliation Pro Workspace if needed.</field>
        </record>

        <record id="task_post_recurring" model="eh.close.task.template">
            <field name="checklist_id" ref="checklist_standard_close"/>
            <field name="sequence">20</field>
            <field name="name">Verify and post recurring journal entries</field>
            <field name="responsible_role">accountant</field>
            <field name="description">Drafts generated by Recurring Invoices and any manual recurring journal entries are reviewed and posted.</field>
        </record>

        <record id="task_review_aged_ar" model="eh.close.task.template">
            <field name="checklist_id" ref="checklist_standard_close"/>
            <field name="sequence">30</field>
            <field name="name">Review aged receivables</field>
            <field name="responsible_role">accountant</field>
            <field name="description">Run Aged Receivable. Reach out on items over 30 days. Open or update Collections Workbench cases as needed.</field>
        </record>

        <record id="task_review_aged_ap" model="eh.close.task.template">
            <field name="checklist_id" ref="checklist_standard_close"/>
            <field name="sequence">40</field>
            <field name="name">Review aged payables</field>
            <field name="responsible_role">accountant</field>
            <field name="description">Run Aged Payable. Confirm scheduled payments and discuss any disputes.</field>
        </record>

        <record id="task_run_trial_balance" model="eh.close.task.template">
            <field name="checklist_id" ref="checklist_standard_close"/>
            <field name="sequence">50</field>
            <field name="name">Run Trial Balance and verify</field>
            <field name="responsible_role">accountant</field>
            <field name="description">Trial Balance debits must equal credits. Investigate any unusual movements.</field>
        </record>

        <record id="task_run_pl_bs" model="eh.close.task.template">
            <field name="checklist_id" ref="checklist_standard_close"/>
            <field name="sequence">60</field>
            <field name="name">Run Profit and Loss and Balance Sheet</field>
            <field name="responsible_role">accountant</field>
            <field name="description">Balance Sheet's automatic Balance Check must be zero. Compare P and L to expectations.</field>
        </record>

        <record id="task_lock_period" model="eh.close.task.template">
            <field name="checklist_id" ref="checklist_standard_close"/>
            <field name="sequence">70</field>
            <field name="name">Lock period in accounting</field>
            <field name="responsible_role">manager</field>
            <field name="description">Set fiscal year lock date on the company so prior period entries cannot be edited.</field>
        </record>

        <record id="task_signoff" model="eh.close.task.template">
            <field name="checklist_id" ref="checklist_standard_close"/>
            <field name="sequence">80</field>
            <field name="name">Final review and sign off</field>
            <field name="responsible_role">manager</field>
            <field name="description">Manager review of the prepared close before approval.</field>
        </record>

    </data>
</odoo>
