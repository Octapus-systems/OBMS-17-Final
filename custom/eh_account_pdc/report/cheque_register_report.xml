<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Cheque register: tabular PDF of selected cheques with status and
        lifecycle dates. Triggered from the cheque list "Print" action so
        the operator picks any subset (filter by state, journal, value
        date, partner) and gets a print-ready register.

        The report iterates the recordset directly; per-record cells are
        rendered against the cheque object so currency formatting honours
        the cheque's currency_id rather than the company default. Status
        badges map cheque states to the suite badge colour palette.
    -->

    <record id="action_report_cheque_register" model="ir.actions.report">
        <field name="name">Cheque Register</field>
        <field name="model">eh.cheque</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eh_account_pdc.report_cheque_register</field>
        <field name="report_file">eh_account_pdc.report_cheque_register</field>
        <field name="binding_model_id" ref="model_eh_cheque"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id"
               ref="eh_account_base.paperformat_eh_landscape"/>
    </record>

    <template id="report_cheque_register">
        <t t-call="web.html_container">
            <t t-call="eh_account_base.eh_report_styles"/>
            <t t-call="web.external_layout">
                <div class="page eh_pdf_page">
                    <h1 class="eh_pdf_title">Cheque Register</h1>
                    <div class="eh_pdf_meta">
                        <span>
                            <strong>Cheques:</strong>
                            <t t-out="len(docs)"/>
                        </span>
                        <span>
                            <strong>Generated:</strong>
                            <t t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                        </span>
                        <span t-if="docs and len(docs.mapped('company_id')) == 1">
                            <strong>Company:</strong>
                            <t t-out="docs[0].company_id.display_name"/>
                        </span>
                    </div>

                    <table class="eh_pdf_table">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Cheque #</th>
                                <th>Direction</th>
                                <th>Bank Journal</th>
                                <th>Counterparty</th>
                                <th>Issue Date</th>
                                <th>Value Date</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="cheque">
                                <tr>
                                    <td>
                                        <t t-out="cheque.name or ''"/>
                                    </td>
                                    <td>
                                        <t t-out="cheque.cheque_number or ''"/>
                                    </td>
                                    <td>
                                        <t t-if="cheque.direction == 'outgoing'">
                                            Issued
                                        </t>
                                        <t t-else="">Received</t>
                                    </td>
                                    <td>
                                        <t t-out="cheque.journal_id.name or ''"/>
                                    </td>
                                    <td>
                                        <t t-out="cheque.partner_id.display_name or ''"/>
                                    </td>
                                    <td>
                                        <t t-out="cheque.issue_date and cheque.issue_date.strftime('%Y-%m-%d') or ''"/>
                                    </td>
                                    <td>
                                        <t t-out="cheque.value_date and cheque.value_date.strftime('%Y-%m-%d') or ''"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="cheque.amount"
                                              t-options="{'widget': 'monetary', 'display_currency': cheque.currency_id}"/>
                                    </td>
                                    <td class="text-center">
                                        <t t-set="badge_class"
                                           t-value="{
                                               'draft':      'eh_pdf_status_neutral',
                                               'registered': 'eh_pdf_status_info',
                                               'presented':  'eh_pdf_status_info',
                                               'cleared':    'eh_pdf_status_ok',
                                               'bounced':    'eh_pdf_status_danger',
                                               'replaced':   'eh_pdf_status_warn',
                                               'cancelled':  'eh_pdf_status_neutral',
                                           }.get(cheque.state, 'eh_pdf_status_neutral')"/>
                                        <span t-att-class="'eh_pdf_status_badge ' + badge_class">
                                            <t t-out="dict(cheque._fields['state'].selection).get(cheque.state, cheque.state)"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="not docs">
                                <tr>
                                    <td colspan="9" class="text-center text-muted"
                                        style="padding: 16pt;">
                                        No cheques selected.
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <t t-call="eh_account_base.eh_report_footer"/>
                </div>
            </t>
        </t>
    </template>

</odoo>
