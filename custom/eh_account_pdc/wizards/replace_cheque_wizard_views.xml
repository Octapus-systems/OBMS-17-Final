<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_cheque_replace_wizard_form" model="ir.ui.view">
        <field name="name">eh.cheque.replace.wizard.form</field>
        <field name="model">eh.cheque.replace.wizard</field>
        <field name="arch" type="xml">
            <form string="Replace Cheque">
                <group>
                    <field name="cheque_id" readonly="1"/>
                    <field name="new_cheque_number"/>
                    <field name="new_book_id"/>
                    <field name="new_amount"/>
                    <field name="new_value_date"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <group>
                    <field name="notes" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Create Replacement"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
