<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_cheque_bounce_wizard_form" model="ir.ui.view">
        <field name="name">eh.cheque.bounce.wizard.form</field>
        <field name="model">eh.cheque.bounce.wizard</field>
        <field name="arch" type="xml">
            <form string="Bounce Cheque">
                <group>
                    <field name="cheque_id" readonly="1"/>
                    <field name="reason_id"/>
                    <field name="dishonour_date"/>
                    <field name="force_current_date"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="bounce_charges"/>
                </group>
                <group>
                    <field name="notes" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Record Bounce"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
