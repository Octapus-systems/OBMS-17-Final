<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_batch_build_wizard_form" model="ir.ui.view">
        <field name="name">eh.batch.payment.build.wizard.form</field>
        <field name="model">eh.batch.payment.build.wizard</field>
        <field name="arch" type="xml">
            <form string="Build batch payment">
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="batch_type" readonly="1"/>
                            <field name="journal_id" readonly="1"/>
                            <field name="payment_date" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="aggregate_per_partner"/>
                        </group>
                    </group>
                    <field name="move_ids"
                           widget="many2many"
                           options="{'no_create': True}">
                        <tree>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                            <field name="amount_residual" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_build"
                            type="object"
                            string="Add to Batch"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
