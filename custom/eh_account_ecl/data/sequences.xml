<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_ecl_run" model="ir.sequence">
            <field name="name">EH ECL Run Reference</field>
            <field name="code">eh.ecl.run</field>
            <field name="prefix">ECL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_ecl_writeoff" model="ir.sequence">
            <field name="name">EH ECL Write-off Reference</field>
            <field name="code">eh.ecl.writeoff</field>
            <field name="prefix">ECLWO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
