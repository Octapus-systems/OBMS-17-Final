<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_recurring_template_form_revenue" model="ir.ui.view">
        <field name="name">eh.recurring.invoice.template.form.revenue.bridge</field>
        <field name="model">eh.recurring.invoice.template</field>
        <field name="inherit_id"
               ref="eh_account_recurring_invoices.view_eh_recurring_template_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="revenue_contract_id"/>
            </field>
        </field>
    </record>

    <record id="view_eh_recurring_template_tree_revenue" model="ir.ui.view">
        <field name="name">eh.recurring.invoice.template.list.revenue.bridge</field>
        <field name="model">eh.recurring.invoice.template</field>
        <field name="inherit_id"
               ref="eh_account_recurring_invoices.view_eh_recurring_template_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="revenue_contract_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
