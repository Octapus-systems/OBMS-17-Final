<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_budget_forecast_revision_tree" model="ir.ui.view">
        <field name="name">eh.budget.forecast.revision.list</field>
        <field name="model">eh.budget.forecast.revision</field>
        <field name="arch" type="xml">
            <tree string="Forecast Revisions" create="0"
                  default_order="revision_date desc">
                <field name="name"/>
                <field name="budget_id"/>
                <field name="revision_date"/>
                <field name="line_count"/>
                <field name="total_amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" optional="hide"
                       groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_budget_forecast_revision_form" model="ir.ui.view">
        <field name="name">eh.budget.forecast.revision.form</field>
        <field name="model">eh.budget.forecast.revision</field>
        <field name="arch" type="xml">
            <form string="Forecast Revision">
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="budget_id" readonly="1"/>
                            <field name="revision_date" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="line_count"/>
                            <field name="total_amount" widget="monetary"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <tree default_order="period_from, account_id">
                            <field name="account_id"/>
                            <field name="period_from"/>
                            <field name="period_to"/>
                            <field name="amount" widget="monetary"/>
                            <field name="source"/>
                            <field name="currency_id" column_invisible="1"/>
                        </tree>
                    </field>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
