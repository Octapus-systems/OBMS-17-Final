<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_budget_split_wizard_form" model="ir.ui.view">
        <field name="name">eh.budget.split.wizard.form</field>
        <field name="model">eh.budget.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Split budget into lines">
                <group>
                    <group>
                        <field name="budget_id" readonly="1"/>
                        <field name="granularity"/>
                        <field name="amount_per_line"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="replace_existing"/>
                    </group>
                    <group>
                        <field name="account_ids" widget="many2many_tags"/>
                        <field name="analytic_account_ids"
                               widget="many2many_tags"/>
                    </group>
                </group>
                <p class="text-muted">
                    Generates one line per account x analytic account x
                    period slice. Leave analytic accounts empty to split by
                    account and period only.
                </p>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate Lines" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
