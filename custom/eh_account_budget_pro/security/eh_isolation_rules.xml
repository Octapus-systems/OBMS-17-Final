<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Multi-company isolation rules for eh_account_budget_pro.
    Auto-generated by hardening pass; one ir.rule per concrete model.
-->
<odoo noupdate="0">
    <data>

        <record id="rule_eh_budget_budget_company" model="ir.rule">
            <field name="name">eh.budget.budget: company isolation</field>
            <field name="model_id" ref="model_eh_budget_budget"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_budget_line_company" model="ir.rule">
            <field name="name">eh.budget.line: company isolation</field>
            <field name="model_id" ref="model_eh_budget_line"/>
            <field name="domain_force">[('budget_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_budget_activity_company" model="ir.rule">
            <field name="name">eh.budget.activity: company isolation</field>
            <field name="model_id" ref="model_eh_budget_activity"/>
            <field name="domain_force">[('budget_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_budget_forecast_revision_company" model="ir.rule">
            <field name="name">eh.budget.forecast.revision: company isolation</field>
            <field name="model_id" ref="model_eh_budget_forecast_revision"/>
            <field name="domain_force">[('budget_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_budget_forecast_revision_line_company" model="ir.rule">
            <field name="name">eh.budget.forecast.revision.line: company isolation</field>
            <field name="model_id" ref="model_eh_budget_forecast_revision_line"/>
            <field name="domain_force">[('revision_id.budget_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_budget_commitment_company" model="ir.rule">
            <field name="name">eh.budget.commitment: company isolation</field>
            <field name="model_id" ref="model_eh_budget_commitment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!--
            eh.budget.report is an _auto=False SQL VIEW. Record rules on the
            base tables (eh.budget.budget / eh.budget.line) never propagate to
            a separate SQL-view model, so without its own rule the Budget vs
            Actual pivot/graph aggregates budgeted and posted-actual GL figures
            across every company. The view already selects b.company_id, so the
            direct company_id path applies.
        -->
        <record id="rule_eh_budget_report_company" model="ir.rule">
            <field name="name">eh.budget.report: company isolation</field>
            <field name="model_id" ref="model_eh_budget_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
