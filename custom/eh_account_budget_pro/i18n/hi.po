#. module: eh_account_budget_pro
#: model_terms:ir.ui.view,arch_db:eh_account_budget_pro.view_eh_budget_form
msgid ""
"This will replace lines with monthly projections from Holt-Winters seasonal "
"forecasting on the last 24 months. Continue?"
msgstr ""
"इससे पंक्तियाँ पिछले 24 महीनों पर Holt-Winters मौसमी पूर्वानुमान से प्राप्त "
