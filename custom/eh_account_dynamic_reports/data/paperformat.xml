<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            Landscape A4 paperformat for the dynamic report PDFs. General
            Ledger has nine columns and would not fit on portrait without
            unreadable shrinkage; landscape works well for both narrow and
            wide reports.
        -->
        <record id="paperformat_eh_dynamic_report" model="report.paperformat">
            <field name="name">A4 Landscape (ERP Heritage Reports)</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <!-- The 30mm top margin pushes body content well below
                 web.external_layout's company header band so the
                 report title never collides with the company logo. -->
            <field name="margin_top">30</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">8</field>
            <field name="margin_right">8</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">8</field>
            <field name="dpi">90</field>
        </record>

    </data>
</odoo>
