<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!--
            Each report opens an OWL client action with report_code in
            context. The component fetches the corresponding
            eh.account.dynamic.report record and renders it interactively.
            For users who want a quick wizard driven export, the wizard
            views are still available via direct navigation.
        -->

        <record id="action_open_executive_summary_viewer" model="ir.actions.client">
            <field name="name">Executive Summary</field>
            <field name="tag">eh_account_dynamic_report</field>
            <field name="context">{'report_code': 'executive_summary'}</field>
        </record>

        <menuitem id="menu_executive_summary"
                  name="Executive Summary"
                  parent="account.menu_finance_reports"
                  action="action_open_executive_summary_viewer"
                  sequence="10"
                  groups="account.group_account_user"/>

