<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_ic_elimination_batch_list" model="ir.ui.view">
        <field name="name">eh.ic.elimination.batch.list</field>
        <field name="model">eh.ic.elimination.batch</field>
        <field name="arch" type="xml">
            <tree string="IC Elimination Batches">
                <field name="name"/>
                <field name="company_a_id"/>
                <field name="company_b_id"/>
                <field name="period_from"/>
                <field name="period_to"/>
                <field name="receivable_total" sum="Total"/>
                <field name="revenue_total" sum="Total"/>
                <field name="unrealised_total" sum="Total"/>
                <field name="mismatch_count"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'computed'"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_ic_elimination_batch_search" model="ir.ui.view">
        <field name="name">eh.ic.elimination.batch.search</field>
        <field name="model">eh.ic.elimination.batch</field>
        <field name="arch" type="xml">
            <search string="IC Elimination Batches">
                <field name="name"/>
                <field name="company_a_id"/>
                <field name="company_b_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="computed" string="Computed"
                        domain="[('state', '=', 'computed')]"/>
                <filter name="posted" string="Posted"
                        domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="with_mismatch" string="With mismatches"
                        domain="[('mismatch_ids', '!=', False)]"/>
                <group>
                    <filter name="group_company_a"
                            string="Company A"
                            context="{'group_by': 'company_a_id'}"/>
                    <filter name="group_company_b"
                            string="Company B"
                            context="{'group_by': 'company_b_id'}"/>
                    <filter name="group_state"
                            string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eh_ic_elimination_batch_form" model="ir.ui.view">
        <field name="name">eh.ic.elimination.batch.form</field>
        <field name="model">eh.ic.elimination.batch</field>
        <field name="arch" type="xml">
            <form string="IC Elimination Batch">
                <header>
                    <button name="action_compute"
                            type="object"
                            string="Compute"
                            class="oe_highlight"
                            invisible="state == 'posted'"/>
                    <button name="action_post"
                            type="object"
                            string="Post Elimination"
                            class="oe_highlight"
                            invisible="state != 'computed'"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"
                            groups="eh_account_base.group_eh_manager"/>
                    <field name="state" widget="statusbar"
                           readonly="1"
                           statusbar_visible="draft,computed,posted"/>
                </header>
                <sheet>
                    <!-- move_id feeds the stat-button modifier; the 17
                         view validator requires modifier fields to be
                         present in the arch. -->
                    <field name="move_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="not move_id">
                            <div class="o_stat_info">
                                <field name="move_state"/>
                                <span class="o_stat_text">Elimination move</span>
                            </div>
                        </button>
                    </div>
                    <h1><field name="name" placeholder="/"/></h1>
                    <group string="Pair and period">
                        <group>
                            <field name="company_a_id"
                                   options="{'no_create': True}"/>
                            <field name="company_b_id"
                                   options="{'no_create': True}"/>
                            <field name="elimination_company_id"
                                   options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="period_from"/>
                            <field name="period_to"/>
                            <field name="block_on_mismatch"/>
                        </group>
                    </group>
                    <group string="Eliminated totals">
                        <group>
                            <field name="receivable_total"/>
                            <field name="payable_total"/>
                            <field name="unrealised_total"/>
                        </group>
                        <group>
                            <field name="revenue_total"/>
                            <field name="expense_total"/>
                            <field name="mismatch_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Elimination lines" name="lines">
                            <field name="line_ids">
                                <tree create="0" delete="0" edit="0">
                                    <field name="kind"/>
                                    <field name="account_id"/>
                                    <field name="source_move_id"/>
                                    <field name="mirror_move_id"/>
                                    <field name="debit" sum="Total"/>
                                    <field name="credit" sum="Total"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Mismatches" name="mismatches">
                            <field name="mismatch_ids">
                                <tree create="0" delete="0" edit="0"
                                      decoration-danger="kind == 'amount'"
                                      decoration-warning="kind in ('no_mirror', 'mirror_draft')">
                                    <field name="kind"/>
                                    <field name="source_move_id"/>
                                    <field name="mirror_move_id"/>
                                    <field name="source_amount"/>
                                    <field name="mirror_amount"/>
                                    <field name="difference"/>
                                    <field name="reason"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Unrealised profit" name="unrealised">
                            <field name="unrealised_line_ids">
                                <tree create="0" delete="0" editable="bottom">
                                    <field name="source_move_id" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="quantity" readonly="1"/>
                                    <field name="unit_cost" readonly="1"/>
                                    <field name="price_subtotal" readonly="1"/>
                                    <field name="margin" readonly="1"/>
                                    <field name="remaining_qty" readonly="1"/>
                                    <field name="fraction_source" readonly="1"/>
                                    <field name="remaining_fraction"/>
                                    <field name="unrealised_amount" sum="Total"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </tree>
                            </field>
                            <p class="text-muted">
                                The margin per line is derived from the
                                source invoice against the product
                                standard cost in the selling company and
                                cannot be typed. When the stock module is
                                installed the remaining fraction is read
                                from the buyer's stock quants; otherwise
                                enter it per line.
                            </p>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="action_eh_ic_elimination_batch" model="ir.actions.act_window">
        <field name="name">IC Elimination Batches</field>
        <field name="res_model">eh.ic.elimination.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_eh_ic_elimination_batch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No elimination batches yet.</p>
            <p>Create one batch per company pair and period. Compute matches the posted inter-company move pairs and builds the receivable/payable and revenue/expense elimination legs; unresolved pairs land on the mismatch tab. Post books the sealed elimination entry in the parent company.</p>
        </field>
    </record>

    <menuitem id="menu_eh_ic_elimination_batch"
              name="IC Elimination Batches"
              parent="account.menu_finance_entries"
              action="action_eh_ic_elimination_batch"
              sequence="45"
              groups="eh_account_base.group_eh_user"/>

</odoo>
