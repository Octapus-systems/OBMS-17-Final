<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_business_combination" model="ir.sequence">
            <field name="name">EH Business Combination Reference</field>
            <field name="code">eh.business.combination</field>
            <field name="prefix">BC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_equity_investment" model="ir.sequence">
            <field name="name">EH Equity Investment Reference</field>
            <field name="code">eh.equity.investment</field>
            <field name="prefix">EQINV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
