<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_cost_card" model="ir.sequence">
            <field name="name">EH Standard Cost Card</field>
            <field name="code">eh.cost.card</field>
            <field name="prefix">SCC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_cost_actual" model="ir.sequence">
            <field name="name">EH Cost Actuals</field>
            <field name="code">eh.cost.actual</field>
            <field name="prefix">CACT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_cost_variance_run" model="ir.sequence">
            <field name="name">EH Cost Variance Run</field>
            <field name="code">eh.cost.variance.run</field>
            <field name="prefix">CVAR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_contribution_report" model="ir.sequence">
            <field name="name">EH Contribution Report</field>
            <field name="code">eh.contribution.report</field>
            <field name="prefix">CMR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
