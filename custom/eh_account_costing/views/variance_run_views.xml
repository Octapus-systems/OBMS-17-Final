<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_cost_variance_run_list" model="ir.ui.view">
        <field name="name">eh.cost.variance.run.list</field>
        <field name="model">eh.cost.variance.run</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total_actual_cost" widget="monetary" optional="show"/>
                <field name="total_absorbed_cost" widget="monetary" optional="show"/>
                <field name="total_variance" widget="monetary"
                       decoration-danger="total_variance &gt; 0"
                       decoration-success="total_variance &lt; 0"/>
                <field name="post_variances" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'computed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_cost_variance_run_form" model="ir.ui.view">
        <field name="name">eh.cost.variance.run.form</field>
        <field name="model">eh.cost.variance.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object"
                            string="Compute" class="btn-primary"
                            invisible="state not in ('draft', 'computed')"/>
                    <button name="action_post" type="object"
                            string="Post" class="btn-primary"
                            invisible="state != 'computed' or not post_variances"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('computed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'computed')"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,computed,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="move_count" widget="statinfo"
                                   string="Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_start"
                                   readonly="state == 'posted'"/>
                            <field name="period_end"
                                   readonly="state == 'posted'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="total_actual_cost"
                                   widget="monetary" readonly="1"/>
                            <field name="total_absorbed_cost"
                                   widget="monetary" readonly="1"/>
                            <field name="total_variance"
                                   widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <group string="Period Actuals">
                        <field name="actual_ids" nolabel="1" colspan="2"
                               readonly="state == 'posted'"
                               widget="many2many">
                            <tree>
                                <field name="name"/>
                                <field name="card_id"/>
                                <field name="period_start"/>
                                <field name="period_end"/>
                                <field name="units_produced"/>
                                <field name="total_actual_cost" widget="monetary"/>
                                <field name="currency_id" column_invisible="1"/>
                            </tree>
                        </field>
                    </group>
                    <group string="Variance Decomposition (adverse positive, favourable negative)">
                        <field name="line_ids" nolabel="1" colspan="2" readonly="1">
                            <tree decoration-success="is_favourable"
                                  decoration-danger="amount &gt; 0">
                                <field name="card_id" optional="show"/>
                                <field name="actual_id" optional="hide"/>
                                <field name="name"/>
                                <field name="element" optional="hide"/>
                                <field name="kind" optional="hide"/>
                                <field name="std_price" optional="show"/>
                                <field name="actual_qty" optional="show"/>
                                <field name="std_qty_allowed" optional="show"/>
                                <field name="actual_cost" widget="monetary" optional="hide"/>
                                <field name="flexible_amount" widget="monetary" optional="hide"/>
                                <field name="absorbed_amount" widget="monetary" optional="hide"/>
                                <field name="amount" widget="monetary" sum="Total"/>
                                <field name="is_favourable" column_invisible="1"/>
                                <field name="currency_id" column_invisible="1"/>
                            </tree>
                        </field>
                    </group>
                    <group string="Posting (optional; analysis-only when off)">
                        <group>
                            <field name="post_variances"
                                   readonly="state == 'posted'"/>
                            <field name="journal_id"
                                   invisible="not post_variances"
                                   readonly="state == 'posted'"/>
                            <field name="absorption_account_id"
                                   invisible="not post_variances"
                                   readonly="state == 'posted'"/>
                        </group>
                        <group invisible="not post_variances">
                            <field name="price_variance_account_id"
                                   readonly="state == 'posted'"/>
                            <field name="usage_variance_account_id"
                                   readonly="state == 'posted'"/>
                            <field name="rate_variance_account_id"
                                   readonly="state == 'posted'"/>
                            <field name="efficiency_variance_account_id"
                                   readonly="state == 'posted'"/>
                            <field name="spend_variance_account_id"
                                   readonly="state == 'posted'"/>
                            <field name="volume_variance_account_id"
                                   readonly="state == 'posted'"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" nolabel="1" colspan="2"
                               placeholder="Root causes behind the period's variances, corrective actions, responsibility notes..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="eh_account_costing_variance_run_view_graph" model="ir.ui.view">
        <field name="name">eh.cost.variance.run.graph</field>
        <field name="model">eh.cost.variance.run</field>
        <field name="arch" type="xml">
            <graph string="Variance Runs" type="bar" sample="1">
                <field name="period_start" interval="month"/>
                <field name="state"/>
                <field name="total_variance" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="eh_account_costing_variance_run_view_pivot" model="ir.ui.view">
        <field name="name">eh.cost.variance.run.pivot</field>
        <field name="model">eh.cost.variance.run</field>
        <field name="arch" type="xml">
            <pivot string="Variance Runs" sample="1">
                <field name="period_start" interval="month" type="row"/>
                <field name="state" type="col"/>
                <field name="total_variance" type="measure"/>
                <field name="total_actual_cost" type="measure"/>
                <field name="total_absorbed_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_eh_cost_variance_run" model="ir.actions.act_window">
        <field name="name">Variance Runs</field>
        <field name="res_model">eh.cost.variance.run</field>
        <field name="view_mode">tree,form,graph,pivot</field>
    </record>

</odoo>
