<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">
    <data>

        <record id="rule_eh_investment_property_company" model="ir.rule">
            <field name="name">eh.investment.property: company isolation</field>
            <field name="model_id" ref="model_eh_investment_property"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_investment_property_transfer_company" model="ir.rule">
            <field name="name">eh.investment.property.transfer: company isolation</field>
            <field name="model_id" ref="model_eh_investment_property_transfer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
