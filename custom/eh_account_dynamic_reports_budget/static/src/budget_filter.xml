<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Add a Budget selector to the P&L report's filter row. Shown only for
         the profit_and_loss report; writes options.budget_id which the
         budget-column compute path reads. -->
    <t t-inherit="eh_account_dynamic_reports.DynamicReportViewer"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('eh_dr_filters')]" position="inside">
            <label class="eh_dr_filter" t-if="reportCode === 'profit_and_loss'">
                <span>Budget</span>
                <select t-on-change="onBudgetChange">
                    <option value="">No budget</option>
                    <t t-foreach="state.budgetChoices" t-as="b" t-key="b.id">
                        <option t-att-value="b.id"
                                t-att-selected="state.options.budget_id === b.id">
                            <t t-esc="b.name"/>
                        </option>
                    </t>
                </select>
            </label>
        </xpath>
    </t>

</templates>
