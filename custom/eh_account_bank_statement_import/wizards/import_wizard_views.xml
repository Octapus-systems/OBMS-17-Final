<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_bsi_wizard_form" model="ir.ui.view">
        <field name="name">eh.account.bank.statement.import.wizard.form</field>
        <field name="model">eh.account.bank.statement.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Bank Statement">
                <sheet>
                    <group>
                        <group>
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="format_key"/>
                            <field name="profile_id"
                                   invisible="format_key != 'csv'"
                                   required="format_key == 'csv'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="filename" readonly="1"/>
                            <field name="file_data" filename="filename"/>
                            <field name="statement_name"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        CSV imports require a profile that maps the columns of the bank's export. OFX and CAMT.053 self-describe their columns; pick the format and upload.
                    </p>
                </sheet>
                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eh_bsi_wizard" model="ir.actions.act_window">
        <field name="name">Import Bank Statement</field>
        <field name="res_model">eh.account.bank.statement.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
