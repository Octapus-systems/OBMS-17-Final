msgstr "Nullbasierter Index der Buchungstext-/Memo-Spalte."

#. module: eh_account_bank_statement_import
#: model:ir.model.fields,help:eh_account_bank_statement_import.field_eh_account_bank_statement_import_profile__col_ref
