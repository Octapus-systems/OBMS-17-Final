msgstr "Nullbasierter Index der Spalte mit dem Namen der Gegenpartei."

#. module: eh_account_bank_statement_import
#: model:ir.model.fields,help:eh_account_bank_statement_import.field_eh_account_bank_statement_import_profile__col_credit
msgid ""
"Zero-based index of the credit column. Use -1 if amount is single-column."
msgstr ""
"Nullbasierter Index der Habenspalte. Verwenden Sie -1, wenn der Betrag in "
"einer einzigen Spalte steht."

#. module: eh_account_bank_statement_import
#: model:ir.model.fields,help:eh_account_bank_statement_import.field_eh_account_bank_statement_import_profile__col_date
