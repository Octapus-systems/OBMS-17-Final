"Zero-based index of the debit column. Use -1 if amount is single-column."
msgstr ""
"Índice basado en cero de la columna de debe. Use -1 si el importe está en "
"una sola columna."

#. module: eh_account_bank_statement_import
#: model:ir.model.fields,help:eh_account_bank_statement_import.field_eh_account_bank_statement_import_profile__col_narration
