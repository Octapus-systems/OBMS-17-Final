<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_bsi_log_list" model="ir.ui.view">
        <field name="name">eh.account.bank.statement.import.log.list</field>
        <field name="model">eh.account.bank.statement.import.log</field>
        <field name="arch" type="xml">
            <tree string="Bank Statement Imports"
                  default_order="imported_at desc"
                  create="0" edit="0">
                <field name="imported_at"/>
                <field name="journal_id"/>
                <field name="format_key"/>
                <field name="filename"/>
                <field name="line_count"/>
                <field name="skipped_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'duplicate'"
                       decoration-danger="state == 'error'"/>
                <field name="imported_by_id"/>
                <field name="statement_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_bsi_log_search" model="ir.ui.view">
        <field name="name">eh.account.bank.statement.import.log.search</field>
        <field name="model">eh.account.bank.statement.import.log</field>
        <field name="arch" type="xml">
            <search string="Bank Statement Imports">
                <field name="filename"/>
                <field name="journal_id"/>
                <field name="format_key"/>
                <field name="imported_by_id"/>
                <field name="statement_id"/>
                <filter name="done" string="Imported"
                        domain="[('state', '=', 'done')]"/>
                <filter name="duplicate" string="Duplicate"
                        domain="[('state', '=', 'duplicate')]"/>
                <filter name="error" string="Error"
                        domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter name="my_imports" string="My Imports"
                        domain="[('imported_by_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_journal" string="Journal"
                            context="{'group_by': 'journal_id'}"/>
                    <filter name="group_format" string="Format"
                            context="{'group_by': 'format_key'}"/>
                    <filter name="group_date" string="Import Date"
                            context="{'group_by': 'imported_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eh_bsi_log_form" model="ir.ui.view">
        <field name="name">eh.account.bank.statement.import.log.form</field>
        <field name="model">eh.account.bank.statement.import.log</field>
        <field name="arch" type="xml">
            <form string="Import Log" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="Import">
                            <field name="imported_at"/>
                            <field name="imported_by_id"/>
                            <field name="journal_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Source File">
                            <field name="format_key"/>
                            <field name="filename"/>
                            <field name="file_hash"/>
                            <field name="profile_id"/>
                        </group>
                    </group>
                    <group string="Result">
                        <field name="state"/>
                        <field name="statement_id"/>
                        <field name="line_count"/>
                        <field name="skipped_count"/>
                    </group>
                    <group invisible="state != 'error'">
                        <field name="error_message" widget="text" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_bsi_log" model="ir.actions.act_window">
        <field name="name">Bank Statement Imports</field>
        <field name="res_model">eh.account.bank.statement.import.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_done': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bank statement imports yet</p>
            <p>This screen is the audit trail of every statement file you import, with its outcome, line count, and any error. Import a file from the Import Bank Statement action and the run is logged here automatically.</p>
        </field>
    </record>

</odoo>
