<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">
    <data>

        <record id="rule_eh_held_for_sale_company" model="ir.rule">
            <field name="name">eh.held.for.sale: company isolation</field>
            <field name="model_id" ref="model_eh_held_for_sale"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_disposal_group_company" model="ir.rule">
            <field name="name">eh.disposal.group: company isolation</field>
            <field name="model_id" ref="model_eh_disposal_group"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_disposal_group_line_company" model="ir.rule">
            <field name="name">eh.disposal.group.line: company isolation</field>
            <field name="model_id" ref="model_eh_disposal_group_line"/>
            <field name="domain_force">[('group_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
