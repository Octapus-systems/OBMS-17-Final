<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_held_for_sale_list" model="ir.ui.view">
        <field name="name">eh.held.for.sale.list</field>
        <field name="model">eh.held.for.sale</field>
        <field name="arch" type="xml">
            <tree decoration-danger="overdue_12m">
                <field name="name"/>
                <field name="description"/>
                <field name="classification_date"/>
                <field name="carrying_amount" widget="monetary"/>
                <field name="fair_value_less_costs" widget="monetary"/>
                <field name="writedown" widget="monetary" optional="show"/>
                <field name="overdue_12m" optional="show"/>
                <field name="is_discontinued" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'held'"
                       decoration-success="state == 'sold'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_held_for_sale_form" model="ir.ui.view">
        <field name="name">eh.held.for.sale.form</field>
        <field name="model">eh.held.for.sale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_classify" type="object"
                            string="Classify as Held for Sale"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_remeasure" type="object"
                            string="Remeasure"
                            invisible="state != 'held'"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_sell" type="object"
                            string="Record Sale" class="btn-primary"
                            invisible="state != 'held'"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_tag_discontinued" type="object"
                            string="Tag Discontinued P&amp;L"
                            invisible="not is_discontinued"
                            groups="eh_account_base.group_eh_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('sold', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,held,sold" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="move_count" widget="statinfo"
                                   string="Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <!-- Not group-gated: the asset_id domain references
                                 company_id, and Odoo 16/17 reject a
                                 group-restricted field used in a domain. -->
                            <field name="company_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="description"/>
                            <field name="classification_date"/>
                            <field name="extension_12m"/>
                            <field name="overdue_12m"/>
                            <field name="is_discontinued"/>
                            <field name="discontinued_pl_account_ids"
                                   widget="many2many_tags"
                                   invisible="not is_discontinued"/>
                            <field name="discontinued_tag_id"
                                   invisible="not discontinued_tag_id"/>
                            <field name="asset_id"
                                   readonly="state != 'draft'"/>
                            <field name="group_id"/>
                            <field name="depreciation_ceased" readonly="1"/>
                        </group>
                        <group>
                            <field name="carrying_amount" widget="monetary"
                                   readonly="state in ('held', 'sold')"/>
                            <field name="fair_value_less_costs" widget="monetary"
                                   readonly="state == 'sold'"/>
                            <field name="writedown" widget="monetary" readonly="1"/>
                            <field name="proceeds" widget="monetary"
                                   invisible="state != 'held'"/>
                        </group>
                    </group>
                    <group string="Accounts">
                        <group>
                            <field name="asset_account_id"/>
                            <field name="impairment_account_id"/>
                        </group>
                        <group>
                            <field name="proceeds_account_id"/>
                            <field name="gain_loss_account_id"/>
                            <field name="journal_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="eh_account_held_for_sale_held_for_sale_view_graph" model="ir.ui.view">
        <field name="name">eh.held.for.sale.graph</field>
        <field name="model">eh.held.for.sale</field>
        <field name="arch" type="xml">
            <graph string="Held for Sale" type="bar">
                <field name="classification_date" interval="month"/>
                <field name="carrying_amount" type="measure"/>
                <field name="writedown" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="eh_account_held_for_sale_held_for_sale_view_pivot" model="ir.ui.view">
        <field name="name">eh.held.for.sale.pivot</field>
        <field name="model">eh.held.for.sale</field>
        <field name="arch" type="xml">
            <pivot string="Held for Sale">
                <field name="state" type="row"/>
                <field name="classification_date" interval="month" type="col"/>
                <field name="carrying_amount" type="measure"/>
                <field name="fair_value_less_costs" type="measure"/>
                <field name="writedown" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_eh_held_for_sale_search" model="ir.ui.view">
        <field name="name">eh.held.for.sale.search</field>
        <field name="model">eh.held.for.sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <filter name="filter_held" string="Held for Sale"
                        domain="[('state', '=', 'held')]"/>
                <filter name="filter_overdue_12m"
                        string="Overdue (12 Months)"
                        domain="[('overdue_12m', '=', True)]"/>
                <filter name="filter_discontinued"
                        string="Discontinued Operations"
                        domain="[('is_discontinued', '=', True)]"/>
                <group>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eh_held_for_sale" model="ir.actions.act_window">
        <field name="name">Held for Sale</field>
        <field name="res_model">eh.held.for.sale</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_eh_held_for_sale_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Classify your first asset held for sale</p>
            <p>Track non-current assets and disposal groups reclassified as held for sale under IFRS 5, remeasured to the lower of carrying amount and fair value less costs to sell. Create a record, set the carrying amount and accounts, then use Classify as Held for Sale.</p>
        </field>
    </record>

</odoo>
