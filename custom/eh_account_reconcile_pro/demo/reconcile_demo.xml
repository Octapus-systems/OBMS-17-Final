<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            Three demo reconciliation rules covering the most common
            SMB shapes:

            * Bank fee write-off: a small debit referenced as 'FEE' is
              auto-classified to the Bank Charges account.
            * Customer payment by reference: anything credited with a
              payment_ref matching the standard invoice number pattern
              gets a high suggestion boost.
            * Vendor payment confirmation: a known supplier name in the
              narration boosts a debit match.

            Rules ship inactive so a fresh install does not silently
            apply rules to live statements; the operator activates the
            ones that match their bank flow. write_off rules are
            intentionally off by default until the holding account is
            chosen.
        -->

        <record id="demo_rule_bank_fee_writeoff" model="eh.reconciliation.rule">
            <field name="name">Bank fee write-off (demo)</field>
            <field name="code">demo_bank_fee</field>
            <field name="sequence">10</field>
            <field name="active" eval="False"/>
            <field name="rule_type">write_off</field>
            <field name="payment_ref_regex">(?i)^(fee|charge|service)$</field>
            <field name="amount_min">0.0</field>
            <field name="amount_max">25.0</field>
            <field name="direction">debit</field>
            <field name="writeoff_label">Bank service charge</field>
            <field name="notes">Set the writeoff_account_id to your Bank Charges account before activating.</field>
        </record>

        <record id="demo_rule_invoice_payment" model="eh.reconciliation.rule">
            <field name="name">Customer payment by invoice reference (demo)</field>
            <field name="code">demo_inv_payment</field>
            <field name="sequence">20</field>
            <field name="active" eval="False"/>
            <field name="rule_type">match</field>
            <field name="payment_ref_regex">(?i)inv[\s\-]*\d{3,}</field>
            <field name="direction">credit</field>
            <field name="amount_min">10.0</field>
            <field name="score_boost">0.6</field>
            <field name="auto_confirm" eval="False"/>
            <field name="notes">Strong boost for credit lines whose payment_ref looks like 'INV-12345'. Pair with the heuristic engine; auto_confirm off so the user reviews each suggestion.</field>
        </record>

        <record id="demo_rule_payroll_run" model="eh.reconciliation.rule">
            <field name="name">Payroll run identifier (demo)</field>
            <field name="code">demo_payroll</field>
            <field name="sequence">30</field>
            <field name="active" eval="False"/>
            <field name="rule_type">match</field>
            <field name="payment_ref_regex">(?i)^(payroll|wages|salaries)\b</field>
            <field name="direction">debit</field>
            <field name="amount_min">100.0</field>
            <field name="score_boost">0.4</field>
            <field name="notes">Boosts payroll-related debit suggestions. Useful when wages run through the bank with a consistent narration.</field>
        </record>

    </data>
</odoo>
