<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_reconciliation_audit_tree" model="ir.ui.view">
        <field name="name">eh.reconciliation.audit.list</field>
        <field name="model">eh.reconciliation.audit</field>
        <field name="arch" type="xml">
            <tree string="Reconciliation Decisions"
                  default_order="decided_at desc"
                  create="0"
                  edit="0"
                  sample="1">
                <field name="decided_at"/>
                <field name="user_id"/>
                <field name="statement_line_id"/>
                <field name="aml_id"/>
                <field name="decision" widget="badge"
                       decoration-success="decision == 'match'"
                       decoration-warning="decision == 'write_off'"
                       decoration-info="decision == 'skip'"/>
                <field name="source"/>
                <field name="confidence" widget="percentage"/>
                <field name="rules_fired"/>
                <field name="session_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_reconciliation_audit_form" model="ir.ui.view">
        <field name="name">eh.reconciliation.audit.form</field>
        <field name="model">eh.reconciliation.audit</field>
        <field name="arch" type="xml">
            <form string="Reconciliation Decision" create="0" edit="0">
                <sheet>
                    <h1>
                        <field name="display_name" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="decided_at"/>
                            <field name="user_id"/>
                            <field name="session_id"/>
                            <field name="decision"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="statement_line_id"/>
                            <field name="aml_id"/>
                            <field name="confidence" widget="percentage"/>
                            <field name="rules_fired"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eh_reconciliation_audit_search" model="ir.ui.view">
        <field name="name">eh.reconciliation.audit.search</field>
        <field name="model">eh.reconciliation.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="statement_line_id"/>
                <field name="aml_id"/>
                <field name="rules_fired"/>
                <filter name="filter_match" string="Matched"
                        domain="[('decision', '=', 'match')]"/>
                <filter name="filter_write_off" string="Written Off"
                        domain="[('decision', '=', 'write_off')]"/>
                <filter name="filter_skip" string="Skipped"
                        domain="[('decision', '=', 'skip')]"/>
                <separator/>
                <filter name="filter_suggestion" string="From Suggestions"
                        domain="[('source', '=', 'suggestion')]"/>
                <filter name="filter_manual" string="Manual"
                        domain="[('source', '=', 'manual')]"/>
                <group>
                    <filter name="group_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_decision" string="Decision"
                            context="{'group_by': 'decision'}"/>
                    <filter name="group_source" string="Source"
                            context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eh_reconciliation_audit" model="ir.actions.act_window">
        <field name="name">Reconciliation Decisions</field>
        <field name="res_model">eh.reconciliation.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id"
               ref="view_eh_reconciliation_audit_search"/>
    </record>

</odoo>
